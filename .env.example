# Secrets and process/bootstrap wiring only.
#
# Mutable runtime/admin settings live in canonical system-data JSON owner files, not in .env:
# - settings.json
# - models.json
# - providers.json
# - scheduler.json
# - capability-tier.json
# - channels.json
# - skills.json
# - trust-policy.json
# - backup.json
#
# Do not put JSON-owned settings here. The runtime ignores env values such as:
# EMBEDDING_PROVIDER, EMBEDDING_MODEL, EMBEDDING_DIMS, OLLAMA_URL, TRANSFORMERS_MODEL,
# MAINTENANCE_INTERVAL_MS, CAPABILITY_TIER, OBSIDIAN_VAULT_NAME, OBSIDIAN_CLI_PATH,
# OBSIDIAN_AUTO_PUBLISH, TELEGRAM_ENABLED, TELEGRAM_ALLOWED_USERS.
#
# Embeddings are configured in settings.json. For local transformers, use settings like:
# {
#   "embeddingProvider": "transformers",
#   "transformersModel": "Xenova/all-MiniLM-L6-v2",
#   "embeddingDims": 384
# }
# The shipped config/settings.seed.json currently defaults to the Ollama embedding profile.

# Default-seed provider secret (config/providers.seed.json + config/models.seed.json)
OPENROUTER_API_KEY=

# Optional alternative provider / image / embedding secrets
# LITELLM_API_KEY=
# EMBEDDING_API_KEY=
# OPENAI_API_KEY=
# FAL_API_KEY=
# HF_TOKEN=hf_xxx                  # optional, needed for gated/private HF repos

# Channel secrets (only if the channel is enabled)
# DISCORD_TOKEN=
# DISCORD_BOT_ID=
# TELEGRAM_BOT_TOKEN=

# API / admin auth (only if those surfaces are enabled)
# API_KEY=
# ADMIN_TOKEN=

# Voice provider secrets (only if the selected providers need them)
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# Identity/bootstrap
CHARACTER_CARD_PATH=./data/character.json

# Runtime path layout:
# - continuous/dev: shared DATA_DIR compatibility, local defaults under project root
# - production: isolated mutable roots with fail-closed overlap guards
# PSFN_RUNTIME_LAYOUT_MODE=continuous      # continuous|dev|production|prod
# PSFN_RUNTIME_ROOT=./runtime/production   # base root for production defaults
# SYSTEM_DATA_DIR=./runtime/production/system-data
# COMPANION_DATA_DIR=./runtime/production/companion-data
# Docker compose runtime split mounts (docker/docker-compose*.yml):
# PSFN_GATEWAY_SOCKET_DIR=/run/psfn
# Guardrail: compose bind mounts are fail-closed (`create_host_path: false`);
# pre-create mode-specific directories before startup.
# PSFN_CONTINUOUS_DATA_DIR=./runtime/continuous/data
# PSFN_CONTINUOUS_WORKSPACE_DIR=./runtime/continuous/workspace
# PSFN_PRODUCTION_SYSTEM_DATA_DIR=./runtime/production/system-data
# PSFN_PRODUCTION_COMPANION_DATA_DIR=./runtime/production/companion-data
# PSFN_PRODUCTION_WORKSPACE_DIR=./runtime/production/workspace
# PSFN_PRODUCTION_LOGS_DIR=./runtime/production/logs
# PSFN_PRODUCTION_TEMP_DIR=./runtime/production/tmp
# PSFN_PRODUCTION_BACKUPS_DIR=./runtime/production/backups
DATA_DIR=./data
# NRC_VAD_LEXICON_PATH=./data/emotion/nrc-vad-lexicon-v2.tsv
# DATABASE_BASENAME=companion        # used when DATABASE_PATH is not set
DATABASE_PATH=./data/companion.db

# Database provider: sqlite (default) or postgres
# DB_PROVIDER=sqlite
# DATABASE_URL=postgres://user:password@localhost:5432/psfn
# DB_MAX_CONNECTIONS=10
MODULE_REGISTRY_PATH=companion/modules/repl-registry.json
# CONFIG_DIR=./config

# OpenAI-compatible API (optional — enables /v1/chat/completions endpoint)
# API_PORT=3000
# API_HOST=127.0.0.1
# ALLOW_INSECURE_LOCAL_API=false             # explicit local-only insecure mode (loopback host required)
# API_CORS_ALLOWLIST=http://127.0.0.1:3001   # comma-separated browser origin allowlist
# API_MODEL_NAME=companion
# Effective think wall-time is min(settings thinkMaxWallTimeMs, active tier cap).
# Keep API timeout above that effective think ceiling with margin.
# API_REQUEST_TIMEOUT_MS=90000

# Admin GUI (optional — Garden management interface)
# ADMIN_PORT=3001
# ADMIN_HOST=127.0.0.1
# ADMIN_ALLOW_INSECURE=false

# Discord runtime behavior (optional env-owned wiring)
# DISCORD_BACKFILL_ON_STARTUP=true   # process recent history after reconnect
# DISCORD_START_RETRY_MAX_ATTEMPTS=0 # 0 = retry forever for transient startup network failures
# DISCORD_START_RETRY_BASE_DELAY_MS=2000
# DISCORD_START_RETRY_MAX_DELAY_MS=30000

# Telegram bootstrap (channel behavior/allowlists live in channels.json)
# PRIMARY_TELEGRAM_USER_ID=123456789    # auto-link telegram identity to primary contact at startup

# Discord voice target wiring
# DISCORD_VOICE_ENABLED=false
# DISCORD_VOICE_GUILD_ID=1310672143113130108
# DISCORD_VOICE_USER_ID=123456789012345678
# DISCORD_VOICE_READY_CUE_TEXT=I am here with you.
# DISCORD_VOICE_DAVE_ENCRYPTION=true
# DISCORD_VOICE_DECRYPTION_FAILURE_TOLERANCE=24
# Voice provider/voice/model selection lives in settings.json

# Wyoming voice bridge (optional — Home Assistant Voice PE integration)
# WYOMING_ENABLED=false              # true to start the Wyoming TCP service
# WYOMING_HOST=127.0.0.1             # bind address for Wyoming TCP server
# WYOMING_PORT=10400                 # bind port for Wyoming TCP server

# Backup/log/temp roots and shutdown timing
# Backup cadence/retention/verification live in backup.json + scheduler.json
# BACKUP_ROOT_DIR=./data/backups     # continuous default: DATA_DIR/backups
# PSFN_LOGS_DIR=./logs               # production default: PSFN_RUNTIME_ROOT/logs
# PSFN_TEMP_DIR=./tmp                # production default: PSFN_RUNTIME_ROOT/tmp
# EXTRACTION_DRAIN_TIMEOUT_MS=10000  # graceful shutdown wait for in-flight extractions

# Gateway/Agent split (optional — not needed for single-process mode)
# GATEWAY_SOCKET=/run/psfn/gateway.sock
# WORKSPACE_PATH=./workspace              # production default: PSFN_RUNTIME_ROOT/workspace
# PSFN_RUNTIME_MODE=split                 # split|yolo (yolo broadens fs.read to full codebase root)
# LIFECYCLE_RESTART_COMMAND=npm run split # set to npm run yolo when using yolo mode
# Prefer startup scripts for wiring:
# npm run split        # default split mode (workspace-scoped reads + allowlist)
# npm run yolo         # split runtime with full-codebase fs.read scope
# ALLOWED_READ_PATHS=/home/user/.openclaw/agents/main
# MODULE_REGISTRY_TRUSTED_READ=false      # set true to trust registry path read without approval
# BEADS_TOOLS_ENABLED=false               # enable beads issue-tracker tools in gateway
# BEADS_ALLOW_ACTIONS=issue.read          # comma-separated actions: issue.read,issue.create,issue.update,issue.close
#
# Gateway TLS trust (optional — for trusting custom CAs on all outbound connections)
# GATEWAY_TLS_CA_PATH=./certs/proxy.example.com/ca.pem  # extra CA to trust (LLM, embeddings, etc.)
# GATEWAY_TLS_REJECT_UNAUTHORIZED=true                   # set false only for dev with self-signed certs
#
# SHELL_EXEC_ENABLED=false
# SHELL_EXEC_ALLOWLIST=node,git
# SHELL_EXEC_ALLOWED_CWD=./workspace
# SHELL_EXEC_DEFAULT_TIMEOUT_MS=5000
# SHELL_EXEC_MAX_TIMEOUT_MS=30000
# SHELL_EXEC_DEFAULT_MAX_OUTPUT_CHARS=20000
# SHELL_EXEC_MAX_OUTPUT_CHARS=100000
# VAULT_TOOLS_ENABLED=false
# VAULT_ALLOW_ACTIONS=vault.read
# AUDIT_DB_PATH=./data/gateway-audit.db

# Notifications / confirmations
# NTFY_BASE_URL=https://ntfy.example.com
# NTFY_TOPIC=psfn-alerts
# NTFY_TOKEN=
# NTFY_TIMEOUT_MS=8000
# NTFY_DEBOUNCE_MS=60000
# CONFIRMATION_EXPIRY_MS=86400000
# CONFIRMATION_OPERATOR_DISCORD_CHANNEL_ID=
# CONFIRMATION_NTFY_TOPIC=psfn-approvals

# Logging
# LOG_LEVEL=info

# Automated E2E harness (optional)
# E2E_DATABASE_PATH=./data/e2e.sqlite
