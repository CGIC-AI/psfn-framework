# Secrets and bootstrap/process wiring only.
#
# Mutable runtime/admin settings live in canonical JSON owner files under system data.
# Keep .env for secrets, sockets/ports, and optional bootstrap path overrides.
#
# Fresh local startup should work with only one provider key.
# Default embeddings use local transformers and auto-download on first use.

# Primary provider secret
OPENROUTER_API_KEY=

# Optional provider / image / embedding secrets
# OPENAI_API_KEY=
# LITELLM_API_KEY=
# EMBEDDING_API_KEY=
# FAL_API_KEY=
# HF_TOKEN=hf_xxx

# Optional channel secrets
# DISCORD_TOKEN=
# DISCORD_BOT_ID=
# TELEGRAM_BOT_TOKEN=
# Multi-companion: each Discord account in channels.json references its token by
# env-var name (tokenRef.envName), never inline. Add one secret per companion
# under the name its account references, e.g.:
# DISCORD_TOKEN_ARIA=

# Optional admin/API auth
# API_KEY=
# ALLOW_INSECURE_LOCAL_API=true
# ADMIN_TOKEN=

# Per-satellite API credentials (Sprint-10 H4). Comma-separated bearer keys,
# each >=16 chars; every key yields a DISTINCT satellite-scoped principal id
# (api-key-<sha256(key)[:24]>) that satellites.json endpoints must list in
# auth.apiKeyPrincipalIds. Satellite keys only work on satellite surfaces
# (satellite chat claims, /v1/satellites/config, /v1/telemetry/ingest).
# API_SATELLITE_KEYS=

# Satellite mTLS trust sources (Sprint-10 C1). Client-cert identity is only
# ever derived from (a) the API listener's real TLS peer certificate, or
# (b) X-PSFN-Client-Cert-* headers from a TLS-terminating proxy that presents
# this shared secret in X-PSFN-Trusted-Proxy-Token (>=32 chars). Without the
# token, inbound client-cert headers are stripped and never trusted.
# API_TRUSTED_PROXY_CLIENT_CERT_TOKEN=
# Direct-TLS API listener (requestCert enabled) for path (a). Cert and key are
# required together; the client CA enables subject/SAN bindings (fingerprint/
# SPKI pins work without chain validation).
# API_TLS_CERT_PATH=
# API_TLS_KEY_PATH=
# API_TLS_CLIENT_CA_PATH=

# Cert-manager sidecar (private CA for satellite mTLS; see docs/certificates.md).
# The bearer token is REQUIRED (>=32 chars): the sidecar refuses to start
# without it. State dir defaults to <system-data>/cert-manager.
# CERT_MANAGER_TOKEN=
# CERT_MANAGER_STATE_DIR=

# Optional voice secrets
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# Optional bootstrap/runtime wiring
# PSFN_RUNTIME_LAYOUT_MODE=continuous
# Multi-companion topology opt-in (process wiring). When enabled, a system-owned
# companions.json fleet manifest is required; when disabled, companions.json must
# be absent. Both mismatches fail closed at startup.
# PSFN_MULTI_COMPANION=0
# Gateway fleet-status surface (multi-companion only): a read-only, loopback-only
# HTTP page + JSON endpoint listing every companion's up/down state, last-seen
# activity, recent violation counts, and Garden links. Setting the port while
# PSFN_MULTI_COMPANION is off fails closed. Fails closed if the port is taken.
# FLEET_STATUS_PORT=10060
# FLEET_STATUS_HOST=127.0.0.1
# PSFN_RUNTIME_ROOT=./runtime/production
# DATA_DIR=./data
# SYSTEM_DATA_DIR=./data
# COMPANION_DATA_DIR=./companion
# CHARACTER_CARD_PATH=./companion/companion.json
POSTGRES_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/psfn
# Optional per-companion Postgres schema (multi-companion tenancy, sprint 10 W2).
# When set to a valid schema identifier (lowercase letter, then lowercase
# letters/digits/underscores), the agent's runtime persistence pins its
# search_path to this schema and creates it on startup. Explicit opt-in: NOT
# derived from COMPANION_ID. Leave unset for single-companion (public schema).
# COMPANION_PG_SCHEMA=companion_550e8400_e29b_41d4_a716_446655440000
# WORKSPACE_PATH=./companion
# MODULE_REGISTRY_PATH=modules/repl-registry.json
# GATEWAY_SOCKET=/run/psfn/gateway.sock
# GATEWAY_SESSION_HMAC_KEY=replace-me-for-non-dev

# Local dev launcher defaults used by `npm run dev` when unset
# API_PORT=10053
# API_HOST=127.0.0.1
# ADMIN_PORT=10054
# ADMIN_HOST=127.0.0.1
# ADMIN_ALLOW_INSECURE=true
# ADMIN_TRANSPORT_MODE=socket
# ADMIN_TRANSPORT_SOCKET=/run/psfn/garden-admin.sock
# For Kubernetes-style Garden -> agent admin transport, set mode explicitly:
# ADMIN_TRANSPORT_MODE=network
# ADMIN_TRANSPORT_URL=https://psfn-agent-admin.default.svc.cluster.local:10055
# ADMIN_TRANSPORT_LISTEN_HOST=0.0.0.0
# ADMIN_TRANSPORT_LISTEN_PORT=10055
# ADMIN_TRANSPORT_TLS_CA_PATH=/run/psfn/admin-transport/ca.crt
# ADMIN_TRANSPORT_TLS_CERT_PATH=/run/psfn/admin-transport/tls.crt
# ADMIN_TRANSPORT_TLS_KEY_PATH=/run/psfn/admin-transport/tls.key
# ALLOW_AGENT_OUTBOUND_NETWORK=true

# Optional channel/bootstrap helpers
# PRIMARY_TELEGRAM_USER_ID=123456789
# DISCORD_BACKFILL_ON_STARTUP=true

# Optional gateway tool wiring
# MODULE_REGISTRY_TRUSTED_READ=false
# ALLOWED_READ_PATHS=/abs/path/one:/abs/path/two
# BEADS_TOOLS_ENABLED=false
# VAULT_TOOLS_ENABLED=false

# Optional runtime roots
# BACKUP_ROOT_DIR=./backups
# Required by config/backup.seed.json when scheduled backups run.
# Generate with: openssl rand -base64 48
# PSFN_BACKUP_ENCRYPTION_KEY=
# PSFN_LOGS_DIR=./logs
# PSFN_TEMP_DIR=./tmp
