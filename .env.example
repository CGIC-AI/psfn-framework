# LLM Provider (OpenRouter)
OPENROUTER_API_KEY=

# Discord
DISCORD_TOKEN=
DISCORD_BOT_ID=1050938702622375987

# Identity
CHARACTER_CARD_PATH=/home/vega/.openclaw/agents/main/character.json

# Models (via OpenRouter)
# Preferred models: z-ai/glm-5, moonshotai/kimi-k2.5, deepseek/deepseek-v3.2
PRIMARY_MODEL=z-ai/glm-5
PRIMARY_PROVIDER=openrouter
PRIMARY_MAX_TOKENS=4096
EXTRACTION_MODEL=deepseek/deepseek-v3.2
EXTRACTION_PROVIDER=openrouter
EXTRACTION_MAX_TOKENS=1024

# Embeddings (local Ollama)
OLLAMA_URL=http://purrsephone.local.vega.nyc:11434
EMBEDDING_MODEL=snowflake-arctic-embed2
EMBEDDING_DIMS=1024

# Paths
DATA_DIR=./data
DATABASE_PATH=./data/purrsephone.db

# LiteLLM proxy (optional — when set, LLM requests route through proxy)
# LITELLM_BASE_URL=http://localhost:4000/v1
# LITELLM_API_KEY=sk-litellm-virtual-...

# OpenAI-compatible API (optional — enables /v1/chat/completions endpoint)
# API_PORT=3000
# API_HOST=127.0.0.1
# API_KEY=
# API_MODEL_NAME=purrsephone
# API_REQUEST_TIMEOUT_MS=90000

# Admin GUI (optional — Purrsephone's Garden management interface)
# ADMIN_PORT=3001
# ADMIN_HOST=127.0.0.1
# ADMIN_TOKEN=
# ADMIN_ALLOW_INSECURE=false

# Discord behavior (optional)
# DISCORD_RESPOND_ALL=false          # Respond to all guild messages, not just mentions
# DISCORD_BACKFILL_ON_STARTUP=true   # Process recent history after reconnect
# DISCORD_HEARTBEAT_CHANNEL=...      # Channel for lifecycle notifications/reflections

# Discord voice MVP (optional)
# DISCORD_VOICE_ENABLED=false
# DISCORD_VOICE_GUILD_ID=1310672143113130108
# DISCORD_VOICE_USER_ID=123456789012345678
# DISCORD_VOICE_READY_CUE_TEXT=I am here with you.
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=rPQ6h200dfjiuYAy0JDA
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Context budgeting (optional — controls how context window is allocated)
# MEMORY_BUDGET_PCT=20               # 5-50, percentage of context window for memories
# EXTRACTION_THRESHOLD_PCT=30        # 10-80, trigger extraction when context reaches this %
# COMPACTION_THRESHOLD_PCT=70        # 50-90, trigger auto-compaction when context reaches this %
# DEFAULT_CONTEXT_WINDOW=128000      # Default context window size in tokens
# SESSION_HISTORY_BUDGET_PCT=6       # 1-80, % of chat context reserved for session history
# MEMORY_RETRIEVAL_BUDGET_PCT=2      # 1-50, % of chat context reserved for retrieved memories
# SESSION_MESSAGE_LIMIT=             # optional hard override (messages); unset = auto budget mode
# MEMORY_RETRIEVAL_LIMIT=            # optional hard override (memories); unset = auto budget mode
# MEMORY_EXTRACTION_MIN_IMPORTANCE=0.45   # 0-1, discard extracted facts below this importance
# MEMORY_EXTRACTION_MIN_CONFIDENCE=0.6    # 0-1, discard extracted facts below this confidence
# MEMORY_EXTRACTION_MIN_NOVELTY=0.35      # 0-1, discard extracted facts too similar to existing channel memories
# MEMORY_EXTRACTION_MAX_WRITES=2          # >=0, max accepted fact writes per extraction run after ranking
# MEMORY_EXTRACTION_TELEMETRY_ENABLED=true
# MEMORY_RETRIEVAL_TELEMETRY_ENABLED=true

# Maintenance (optional — controls background maintenance scheduling)
# MAINTENANCE_INTERVAL_MS=300000     # 60000-86400000, interval between maintenance runs (ms)
# BACKUP_INTERVAL_MS=86400000        # >=60000, scheduled backup interval (ms)
# BACKUP_RETENTION_COUNT=7           # >=1, number of backup snapshots to keep
# BACKUP_ROOT_DIR=./data/backups     # backup output directory (default: DATA_DIR/backups)
# EXTRACTION_DRAIN_TIMEOUT_MS=10000  # graceful shutdown wait for in-flight extractions

# LLM retry behavior (optional — transient failure resilience)
# RETRY_MAX_ATTEMPTS=3               # 0-10, number of automatic retries on transient errors
# RETRY_BASE_DELAY_MS=2000           # 500-30000, exponential backoff base delay in ms

# Capability tier (optional — default "nursery")
# CAPABILITY_TIER=nursery            # nursery|apprentice|autonomous|custom

# Gateway/Agent split (optional — not needed for single-process mode)
# GATEWAY_SOCKET=/run/psfn/gateway.sock
# WORKSPACE_PATH=./workspace
# ALLOWED_READ_PATHS=/home/vega/.openclaw/agents/main
# MODULE_REGISTRY_TRUSTED_READ=false      # set true to trust registry path read without approval
# MODULE_REGISTRY_PATH=purrsephone/modules/repl-registry.json
# ALLOW_HTTP_FETCH=false
# FETCH_DOMAIN_ALLOWLIST=example.com,docs.crawl4ai.com
# AUDIT_DB_PATH=./data/gateway-audit.db
# NTFY_BASE_URL=https://ntfy.example.com
# NTFY_TOPIC=psfn-alerts
# NTFY_TOKEN=
# NTFY_TIMEOUT_MS=8000
# NTFY_DEBOUNCE_MS=60000
# CONFIRMATION_EXPIRY_MS=86400000
# CONFIRMATION_OPERATOR_DISCORD_CHANNEL_ID=
# CONFIRMATION_NTFY_TOPIC=psfn-approvals

# Logging
# LOG_LEVEL=info

# Automated E2E harness (optional)
# E2E_DATABASE_PATH=./data/e2e.sqlite
