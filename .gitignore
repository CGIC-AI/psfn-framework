# bv (beads viewer) local config and caches
.bv/

# Local beads state lives in the shared Dolt server and must not dirty code commits.
# Exception: issues.jsonl is tracked so bead state syncs across machines over git
# (export here -> commit -> pull + import/rehydrate on the other machine). Everything
# else under .beads/ (the Dolt DB, credential key, config, runtime locks) stays ignored.
.beads/*
!.beads/issues.jsonl

# Internal planning/audit artifacts (non-product docs)
history/
working_doc/
working_docs/*primer*
working_docs/*Primer*
working_docs/*PRIMER*
working_docs/PSFN_PROJECT_STATE_20260611.md
working_docs/private-live-ops.md
workspace/

# Deployment-specific operator inputs; copy from the tracked example.
scripts/ops/private-ops.env
deploy/helm/psfn/overlays/*.local.values.yaml

# Companion personal files live inside the repo tree but are runtime/personal data.
purrsephone/

# Imported package environments are local build state.
apps/satellite-hub/.venv/

# SvelteKit admin UI
.svelte-kit/
admin-ui/node_modules/
admin-ui/build/
admin-ui/.svelte-kit/

