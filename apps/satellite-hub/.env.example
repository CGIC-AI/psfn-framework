DEVICE_TRANSPORT=esphome

ESPHOME_HOST=
ESPHOME_PORT=6053
ESPHOME_NOISE_PSK=
ESPHOME_EXPECTED_NAME=

REALTIME_VOICE_BIND_HOST=0.0.0.0
REALTIME_VOICE_PORT=8787
REALTIME_VOICE_PUBLIC_HOST=

AUDIO_SERVER_BIND_HOST=0.0.0.0
AUDIO_SERVER_PORT=8099
AUDIO_PUBLIC_HOST=
AUDIO_PUBLIC_PORT=

DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
FAL_KEY=

PSFN_API_BASE_URL=http://127.0.0.1:3100/v1
PSFN_API_KEY=
# Optional full-companion model override. When set, Satellite Hub sends the
# provider/model override with system_prompt_mode=default so PSFN retains the
# companion identity, memory, tools, and channel context instead of opening a
# raw model-room conversation.
PSFN_PROVIDER=
PSFN_MODEL=psfn
PSFN_CLAIM_NAMESPACE=satellite.endpoint
# Defaults to PSFN_CAPABILITY_PROFILE. Use world-avatar for a registered 3D-world endpoint;
# do not reuse voxta-avatar unless the endpoint actually speaks the Voxta facade protocol.
PSFN_CLAIM_TYPE=
PSFN_CHANNEL_TYPE=satellite.endpoint
# Supported profiles: voice-only, text-only, voxta-avatar, world-avatar,
# vision-capable, telemetry-only, mobile-location.
PSFN_CAPABILITY_PROFILE=voice-only
PSFN_SATELLITE_ID=hub
PSFN_ENDPOINT_ID=hub
PSFN_ENDPOINT_NAME=PSFN Satellite Hub
PSFN_ENDPOINT_CLASS=
PSFN_LOCATION_MODE=
PSFN_TELEMETRY_MODE=
PSFN_TELEMETRY_CATEGORIES=
PSFN_CLIENT_CERT_PATH=
PSFN_CLIENT_KEY_PATH=
PSFN_CA_CERT_PATH=
PSFN_AUTHOR_ID=
PSFN_AUTHOR_NAME=
PSFN_COMPANION_ID=

# The Python ESPHome/realtime fallback uses current Fleet owner authority to
# mint one short-lived Hub-device assertion per physical turn. Set these two
# owner paths together with HUB_DEVICE_ASSERTION_PRIVATE_KEY_PATH and
# HUB_DEVICE_ASSERTION_TTL_SECONDS below. The selected endpoint in satellites.json
# must have an active hubDeviceEnrollment, and the private key must match the
# single active verifier in fleet-auth.json.
HUB_DEVICE_ASSERTION_FLEET_AUTH_PATH=
HUB_DEVICE_ASSERTION_SATELLITE_REGISTRY_PATH=

# Bounds the empty-response fallback tail for voice turns. PSFN_VOICE_REPLY_DEADLINE_MS
# is the total budget for producing a reply across all attempts; when a primary
# completion comes back empty the hub retries once within this budget and otherwise
# fails closed instead of leaving the voice client waiting on an unbounded fallback.
# PSFN_VOICE_ATTEMPT_TIMEOUT_MS caps a single attempt (clamped to the remaining
# deadline) and must be <= PSFN_VOICE_REPLY_DEADLINE_MS.
# Set both voice values together; a one-sided override is rejected at startup.
PSFN_VOICE_REPLY_DEADLINE_MS=8000
PSFN_VOICE_ATTEMPT_TIMEOUT_MS=6000

# Authenticated typed user.text turns use a separate budget so normal framework
# completions are not cut off by the latency-sensitive voice deadline. The
# 80-second total leaves 10 seconds for a clear Hub error to reach the caller
# before the framework API's current 90-second request timeout. The attempt cap
# leaves a bounded tail for one retry when the first completion is genuinely
# empty. These values do not affect voice or Voxta turns.
# Set both text values together. The total may be lowered but cannot exceed
# 80000 ms while the framework API request timeout remains 90000 ms.
PSFN_TEXT_REPLY_DEADLINE_MS=80000
PSFN_TEXT_ATTEMPT_TIMEOUT_MS=75000

# Pinned conversation/session suffix for every ESPHome turn. It overrides any
# native API conversation id and defaults to PSFN_SATELLITE_ID, so one endpoint
# cannot accidentally fork channels across turns or bridge restarts.
VOICE_CONVERSATION_ID=

# Optional PSFN companion backplane bridge (touch stimuli, approvals, artifact events, tool activity).
# The endpoints live on the same gateway API edge as /v1/chat/completions, so this is
# typically the same value as PSFN_API_BASE_URL (e.g. http://127.0.0.1:3100/v1).
# Leave PSFN_COMPANION_BASE_URL unset to disable the bridge entirely; the hub then relays nothing.
# Auth defaults to PSFN_API_KEY when PSFN_COMPANION_API_KEY is unset. The key's principal must be
# listed on this hub's endpoint entry in PSFN's satellites.json and granted the telemetry scopes
# approvals, artifacts, and tool_activity. The bridge identifies itself with the satellite registry
# identity from PSFN_SATELLITE_ID, PSFN_ENDPOINT_ID, and PSFN_CLAIM_TYPE/PSFN_CAPABILITY_PROFILE.
PSFN_COMPANION_BASE_URL=
PSFN_COMPANION_API_KEY=
PSFN_COMPANION_PREVIEW_MAX_BYTES=1048576
PSFN_COMPANION_RECONNECT_BASE_MS=1000
PSFN_COMPANION_RECONNECT_MAX_MS=30000

# Optional Hub-owned static map from Eidoverse world/region labels to existing
# PSFN places.json IDs. See config/eidoverse-place-map.example.json.
EIDOVERSE_PLACE_MAP_PATH=

# Optional Phase-1 eidoverse embodiment client. The Hub spawns the configured
# local MCP server over stdio and exposes only look, say, and pending_pings.
# EIDOVERSE_MCP_TOKEN_REF names the Hub-custodied environment entry containing
# the join token; the reference is passed through config, never the token value.
EIDOVERSE_MCP_ENABLED=false
EIDOVERSE_MCP_COMMAND=
EIDOVERSE_MCP_ARGS_JSON=[]
EIDOVERSE_MCP_WORLD_URL=
EIDOVERSE_MCP_TOKEN_REF=EIDOVERSE_JOIN_TOKEN
EIDOVERSE_MCP_WORLD_NAME=
EIDOVERSE_MCP_AGENT_NAME=
EIDOVERSE_MCP_RECONNECT_BASE_MS=250
EIDOVERSE_MCP_RECONNECT_MAX_MS=5000
EIDOVERSE_MCP_RECONNECT_MAX_ATTEMPTS=3
EIDOVERSE_MCP_REQUEST_TIMEOUT_MS=10000
# Hub-owned polling and ambient-event treatment. Producer suggestedTreatment
# declarations never override these local wake-policy settings.
EIDOVERSE_MCP_PENDING_PINGS_POLL_INTERVAL_MS=2000
EIDOVERSE_MCP_AMBIENT_SAY_DEBOUNCE_MS=180000
EIDOVERSE_JOIN_TOKEN=

# Optional Home Assistant world transport. When enabled, all values below are
# required. Keep HOME_ASSISTANT_TOKEN and HUB_CONTROL_TOKEN in the ignored live
# .env or deployment secret store; never commit them.
HOME_ASSISTANT_ENABLED=false
HOME_ASSISTANT_BASE_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_RECONNECT_BASE_MS=1000
HOME_ASSISTANT_RECONNECT_MAX_MS=30000
HOME_ASSISTANT_REQUEST_TIMEOUT_MS=10000
HUB_CONTROL_BIND_HOST=127.0.0.1
HUB_CONTROL_PORT=8788
HUB_CONTROL_TOKEN=
HUB_CONTROL_MAX_BODY_BYTES=65536
HUB_DEVICE_REGISTRY_PATH=config/hub-devices.json
# Required as one complete set whenever HUB_DEVICE_REGISTRY_PATH is set. The
# private key remains Hub-only and its file must be mode 0600 (or stricter).
HUB_DEVICE_ASSERTION_ISSUER=psfn-satellite-hub
HUB_DEVICE_ASSERTION_KID=
HUB_DEVICE_ASSERTION_AUDIENCE=
HUB_DEVICE_ASSERTION_PRIVATE_KEY_PATH=
HUB_DEVICE_ASSERTION_TTL_SECONDS=30

# Per-device bearer sent only in the realtime hello. Store its SHA-256 digest in
# HUB_DEVICE_REGISTRY_PATH; never put this plaintext value in the registry.
HUB_DEVICE_TOKEN=
HUB_RELAY_DEVICE_TOKEN=

VOXTA_FACADE_ENABLED=true
VOXTA_SATELLITE_ID=voxta-vam
VOXTA_SATELLITE_NAME=Voxta VaM
VOXTA_SESSION_ID=
VOXTA_CHAT_ID=
VOXTA_ASSISTANT_ID=psfn-assistant
VOXTA_ASSISTANT_NAME=PSFN
VOXTA_USER_ID=voxta-user
VOXTA_USER_NAME=User
VOXTA_APP_LABEL=PSFN Satellite Hub
VOXTA_CLIENT_VERSION=1.2.1
# Optional public URL base for proxy-fetchable Voxta audio artifacts. Defaults to AUDIO_PUBLIC_HOST/REALTIME_VOICE_PUBLIC_HOST.
VOXTA_PUBLIC_BASE_URL=
# Direct VaM mode: set to VaM's Custom\Sounds\Voxta folder so replyChunk.audioUrl is a local .wav path.
VOXTA_AUDIO_FOLDER=
# Proxy/sidecar mic mode: emit recordingRequest and accept /ws/audio/input/stream PCM for STT.
VOXTA_STT_STREAM_ENABLED=false
VOXTA_VISION_CAPTURE_TIMEOUT_MS=1500
VOXTA_APP_TRIGGER_ALLOWLIST=

# Local VaM relay process. Run on the VaM Windows machine; VaM points at this
# single local endpoint while the relay talks to the remote hub.
PSFN_VOXTA_RELAY_LISTEN_URL=http://127.0.0.1:8789
PSFN_VOXTA_RELAY_REMOTE_HUB_URL=http://companion.example.com:8789/hub
PSFN_VOXTA_RELAY_REMOTE_API_BASE_URL=http://companion.example.com:8789
PSFN_VOXTA_RELAY_AUDIO_FOLDER=
PSFN_VOXTA_RELAY_REMOTE_BEARER_TOKEN=

CONTINUE_CONVERSATION=true
SESSION_TTL_SECONDS=300
ANNOUNCEMENT_TIMEOUT_SECONDS=120
VOICE_REPLY_TIMEOUT_SECONDS=30
VOICE_INITIAL_SILENCE_TIMEOUT_SECONDS=4.0
VOICE_ENDPOINTING_GRACE_SECONDS=2.0
VOICE_SILENCE_TIMEOUT_SECONDS=1.2
VOICE_MAX_TURN_SECONDS=20
VOICE_SPEECH_RMS_THRESHOLD=25
VOICE_MIN_SPEECH_CHUNKS_FOR_ENDPOINTING=4
