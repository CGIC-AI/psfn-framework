[Unit]
Description=PSFN Waveshare bedroom voice bridge
After=network-online.target k3s.service
Wants=network-online.target
RequiresMountsFor=%h/psfn-satellite-hub

[Service]
Type=simple
User=psfn
Group=psfn
WorkingDirectory=%h/psfn-satellite-hub
Environment=PATH=%h/psfn-satellite-hub/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/usr/bin/test -x /usr/bin/ffmpeg
ExecStart=%h/psfn-satellite-hub/.venv/bin/hub run
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=psfn-waveshare-bedroom

[Install]
WantedBy=multi-user.target
