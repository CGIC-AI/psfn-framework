{
  "name": "psfn-companion-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "PWA Companion Cockpit — client of the PSFN-Satellite Hub. Relational chat + presence/operational state only. No core, no server.",
  "scripts": {
