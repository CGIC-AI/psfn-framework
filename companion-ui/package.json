    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.11",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "10.0.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "lucide-react": "1.20.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
