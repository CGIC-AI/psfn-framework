{
  "schemaVersion": 1,
  "bus": {
    "eligibleClasses": [
      "subagent.bounded",
      "shard.long_horizon",
      "memory.extraction",
      "memory.sleeptime",
      "memory.social_graph_builder",
      "intention.concern_candidate_review",
