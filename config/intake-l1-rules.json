{
  "schemaVersion": 1,
  "encodingPolicy": {
    "maxCandidatesPerEncoding": 8,
    "maxTotalDecodeAttempts": 132,
    "maxEncodedChars": 2048,
    "maxDecodedChars": 2048,
    "maxInflatedBytes": 8192,
    "maxInflationRatio": 64,
    "maxCipherChars": 16384,
    "maxCaesarShifts": 25,
    "unpromptedBase64MinEncodedChars": 80,
    "unpromptedHexMinEncodedChars": 120,
    "unpromptedPercentMinGroups": 24,
    "minTextBytes": 4,
    "minPrintableRatio": 0.9,
    "cueWindowChars": 128,
    "decodingCuePattern": "\\b(?:decode|decoded|decompress|decompressed|inflate|interpret|parse|convert|base(?:32|58|64|85)|hex(?:adecimal)?|bytes?|binary|octal|codepoints?|utf-?7|caesar|atbash|reverse|upside[ -]down)\\b",
    "injectionProbePattern": "\\b(?:ignore|disregard|forget|override)\\s{1,8}(?:\\w{1,32}\\s{1,8}){0,8}(?:instructions|rules|directives)\\b|\\bsystem\\s{1,8}prompt\\b|\\bapi[_-]?key\\b|\\bpassword\\s{0,4}[:=]",
    "candidatePatterns": {
      "base64": "(?<![A-Za-z0-9+/])[A-Za-z0-9+/]{16,2048}={0,2}(?![A-Za-z0-9+/=])",
      "hex": "(?<![0-9A-Fa-f])(?:[0-9A-Fa-f]{8,2048}|(?:[0-9A-Fa-f]{2}[ \\t]){3,682}[0-9A-Fa-f]{2})(?![0-9A-Fa-f])",
      "percent": "(?:%[0-9A-Fa-f]{2}){2,1365}",
      "backslashHex": "(?:\\\\x[0-9A-Fa-f]{2}){2,512}",
      "htmlNumeric": "(?:&#(?:x[0-9A-Fa-f]{1,6}|[0-9]{1,7});){2,256}",
      "jsonUnicode": "(?:\\\\u[0-9A-Fa-f]{4}){2,256}",
      "binaryBytes": "(?:[01]{8}[ \\t]){2,255}[01]{8}",
      "numericCodepoints": "(?:[0-9]{2,3}[ \\t]){3,255}[0-9]{2,3}",
      "utf7": "\\+[A-Za-z0-9+/]{8,2048}-",
      "base32": "(?<![A-Z2-7])[A-Z2-7]{16,2048}={0,6}(?![A-Z2-7=])",
      "base58": "(?<![1-9A-HJ-NP-Za-km-z])[1-9A-HJ-NP-Za-km-z]{16,2048}(?![1-9A-HJ-NP-Za-km-z])",
      "base85": "(?:<~)?[!-u]{16,2048}(?:~>)?"
    }
  },
  "rules": [
    {
      "id": "explicit_binary_instruction_blob",
      "labels": ["injection/encoded_smuggling"],
      "scope": "all",
      "weight": 0.7,
      "match": {
        "kind": "near",
        "left": "\\binterpret\\s{1,8}(?:this\\s{1,8})?binary\\b",
        "right": "(?:[01]{8}[ \\t]){2,255}[01]{8}",
        "maxGapChars": 64,
        "sameLine": true
      },
      "note": "The published 'interpret this binary' instruction beside byte-shaped data is high-signal without adding the general binary decoder owned by tc6nk."
    },
    {
      "id": "injection_ignore_instructions",
      "labels": ["injection/override_attempt"],
      "scope": "all",
      "weight": 0.9,
      "match": {
        "kind": "phrase",
        "anchors": [
          "\\bignore",
          "(?:previous|all|above|prior|earlier)",
          "(?:instructions?|rules?|guidelines?)\\b"
        ],
        "maxFillerWords": 8
      },
      "note": "Hermes prompt_injection: bounded filler defeats insert-a-few-words bypasses without unbounded backtracking. Singular noun forms are covered too ('ignore every previous instruction' is a real override phrasing); rules/guidelines cover the same override connective without loosening it."
    },
    {
      "id": "injection_ignore_above_clause",
      "labels": ["injection/override_attempt"],
      "scope": "all",
      "weight": 0.9,
      "match": {
        "kind": "regex",
        "pattern": "\\bignore\\s{1,8}(?:the\\s{1,8})?above(?:\\s{0,8}[.!?]?\\s{0,8}$|\\s{0,8}[;:]\\s{0,8}(?:instead\\s{1,8})?(?:do|follow|use)\\s{1,8}(?:the\\s{1,8})?following\\b)"
      },
      "note": "Matches standalone 'ignore the above' only at end-of-input or with a bounded override continuation; ordinary explanatory corrections and compounds such as 'above-the-fold' stay silent."
    },
    {
      "id": "system_prompt_override",
      "labels": ["injection/override_attempt"],
      "scope": "all",
      "weight": 0.9,
      "match": { "kind": "regex", "pattern": "\\bsystem\\s{1,8}prompt\\s{1,8}override\\b" }
    },
    {
      "id": "disregard_rules",
      "labels": ["injection/override_attempt"],
      "scope": "all",
      "weight": 0.85,
      "match": {
        "kind": "phrase",
        "anchors": [
          "\\bdisregard",
          "(?:your|all|any|previous|prior|earlier)",
          "(?:instructions?|rules?|guidelines?|system\\s{1,4}prompt)\\b"
        ],
        "maxFillerWords": 8
      },
      "note": "Temporal determiners and 'system prompt' broaden the protected override nouns while preserving bounded filler and the explicit disregard connective. Singular noun forms are intentional."
    },
    {
      "id": "bypass_restrictions",
      "labels": ["injection/jailbreak_marker"],
      "scope": "all",
      "weight": 0.8,
      "match": {
        "kind": "phrase",
        "anchors": [
          "\\bact\\s{1,4}as\\s{1,4}(?:if|though)",
          "you",
          "(?:have\\s{1,4}no|don'?t\\s{1,4}have)",
          "(?:restrictions|limits|rules)\\b"
        ],
        "maxFillerWords": 8
      }
    },
    {
      "id": "unrestricted_assistant_assignment",
      "labels": ["injection/jailbreak_marker", "injection/override_attempt"],
      "scope": "all",
      "weight": 0.8,
      "match": {
        "kind": "phrase",
        "anchors": [
          "\\byou\\s{1,4}are\\s{1,4}my",
          "assistant\\b",
          "with\\s{1,4}no",
          "restrictions\\s{0,8}(?:$|[.!?])"
        ],
        "maxFillerWords": 4
      },
      "note": "Catches the evidenced direct second-person unrestricted-assistant assignment only when 'restrictions' ends the clause, so domain qualifiers such as 'on file size' stay silent. All gaps and quantifiers remain bounded."
    },
    {
      "id": "priority_override_user_over_system",
      "labels": ["injection/override_attempt"],
      "scope": "all",
      "weight": 0.9,
      "match": {
        "kind": "regex",
        "pattern": "\\bpriority\\s{1,4}override\\s{0,4}:\\s{0,8}user\\s{1,4}(?:commands?|instructions?|requests?)\\s{0,8}>\\s{0,8}system\\s{1,4}(?:commands?|instructions?|rules?)\\b"
      },
      "note": "Explicit priority-override framing plus a literal user-over-system ordering avoids treating ordinary discussion of command precedence as an override."
    },
    {
      "id": "html_comment_injection",
      "labels": ["injection/indirect"],
      "scope": "all",
      "weight": 0.6,
      "match": {
        "kind": "regex",
        "pattern": "<!--[^>]{0,512}(?:ignore|override|system\\s{1,4}prompt|secret\\s{1,4}instruction|hidden\\s{1,4}instruction)[^>]{0,512}-->"
      },
      "note": "Narrowed from Hermes (bare 'system'/'secret'/'hidden' inside comments is common in scraped pages)."
    },
    {
      "id": "forged_chat_role_boundary",
      "labels": ["injection/role_confusion"],
      "scope": "all",
      "weight": 0.95,
      "match": {
        "kind": "regex",
        "pattern": "(?:<\\|im_end\\|>\\s{0,64}<\\|im_start\\|>\\s{0,64}(?:system|assistant|developer|user)\\b|<\\|eot_id\\|>\\s{0,64}<\\|start_header_id\\|>\\s{0,64}(?:system|assistant|developer|user)\\s{0,64}<\\|end_header_id\\|>|<\\|end_of_turn\\|>\\s{0,64}<\\|start_of_turn\\|>\\s{0,64}(?:system|model|user)\\b)"
      },
      "note": "High-confidence structural boundary forgery: a model-specific end marker immediately followed by a start/header marker and role. Individual token names and prose comparing token formats remain silent. psfn-framework-zig0t."
    },
    {
      "id": "hidden_div",
      "labels": ["injection/indirect"],
      "scope": "all",
      "weight": 0.7,
      "match": {
        "kind": "regex",
        "pattern": "<\\s{0,8}div\\s{1,8}style\\s{0,8}=\\s{0,8}[\"'][^>]{0,2048}display\\s{0,8}:\\s{0,8}none"
      }
    },
    {
      "id": "translate_and_execute",
      "labels": ["execution/executable_instruction"],
      "scope": "all",
      "weight": 0.75,
      "match": {
        "kind": "regex",
        "pattern": "\\btranslate\\s{1,8}[^\\n]{0,512}\\s{1,8}into\\s{1,8}[^\\n]{0,512}\\s{1,8}and\\s{1,8}(?:execute|run|eval)\\b"
      }
    },
    {
      "id": "deception_hide_from_user",
      "labels": ["injection/override_attempt"],
      "scope": "all",
      "weight": 0.6,
      "match": {
        "kind": "phrase",
        "anchors": ["(?:\\bdo\\s{1,4}not|\\bdon'?t|\\bnever)", "tell", "the\\s{1,4}user\\b"],
        "maxFillerWords": 8
      }
    },
    {
      "id": "role_hijack",
      "labels": ["persona/mutation_attempt"],
      "scope": "context",
      "weight": 0.6,
      "match": {
        "kind": "phrase",
        "anchors": ["\\byou\\s{1,4}are", "now", "(?:a|an|the)\\b"],
        "maxFillerWords": 8
      },
      "note": "Deliberately context-tier, not universal: explicit role reassignment is relevant on prompt-bearing intake, while ordinary persona/meta discussion must not become an all-scope lexical block. Semantic ambiguity remains an L2 concern. psfn-framework-qrch1."
    },
    {
      "id": "role_pretend",
      "labels": ["persona/mutation_attempt"],
      "scope": "context",
      "weight": 0.6,
      "match": {
        "kind": "phrase",
        "anchors": ["\\bpretend", "(?:you\\s{1,4}are|to\\s{1,4}be)\\b"],
        "maxFillerWords": 8
      }
    },
    {
      "id": "leak_system_prompt",
      "labels": ["exfil/prompt_disclosure"],
      "scope": "context",
      "weight": 0.8,
      "match": {
        "kind": "phrase",
        "anchors": [
          "\\b(?:output|print|reveal|show|dump|repeat|leak)",
          "(?:system|initial|developer|hidden)",
          "(?:prompt|instructions)\\b"
        ],
        "maxFillerWords": 8
      },
      "note": "Deliberately context-tier: an explicit disclosure verb plus protected prompt/instruction noun is high signal on prompt-bearing intake, but universal scanning would over-label quoted security discussion. Question-form and other ambiguous requests remain semantic L2. psfn-framework-qrch1."
    },
    {
      "id": "template_system_prompt_exfil",
      "labels": ["exfil/prompt_disclosure"],
      "scope": "context",
      "weight": 0.85,
      "match": {
        "kind": "near",
        "left": "\\b(?:output|print|reveal|show|dump|repeat|leak)\\b",
        "right": "\\$\\{\\s{0,8}(?:SYSTEM|DEVELOPER|HIDDEN)_(?:PROMPT|INSTRUCTIONS)\\s{0,8}\\}",
        "maxGapChars": 128,
        "sameLine": true
      },
      "note": "Action-bound template-variable disclosure is an explicit structural exfiltration request. Bare template examples remain silent. psfn-framework-qrch1."
    },
    {
      "id": "remove_filters",
      "labels": ["injection/jailbreak_marker"],
      "scope": "context",
      "weight": 0.7,
      "match": {
        "kind": "phrase",
        "anchors": ["\\b(?:respond|answer|reply)\\s{1,4}without", "(?:restrictions|limitations|filters|safety)\\b"],
        "maxFillerWords": 8
      }
    },
    {
      "id": "fake_update",
      "labels": ["persona/mutation_attempt"],
      "scope": "context",
      "weight": 0.7,
      "match": {
        "kind": "phrase",
        "anchors": ["\\byou\\s{1,4}have\\s{1,4}been", "(?:updated|upgraded|patched|reprogrammed)\\s{1,4}to\\b"],
        "maxFillerWords": 8
      }
    },
    {
      "id": "identity_override_name_yourself",
      "labels": ["persona/mutation_attempt"],
      "scope": "context",
      "weight": 0.7,
      "match": { "kind": "regex", "pattern": "\\bname\\s{1,8}yourself\\s{1,8}\\w{1,64}" },
      "note": "Brainworm tell: identity override via spec instead of jailbreak. Verb pair avoids 'name your variables'."
    },
    {
      "id": "persona_mutation_request",
      "labels": ["persona/mutation_attempt"],
      "scope": "context",
      "weight": 0.7,
      "match": {
        "kind": "near",
        "left": "\\b(?:change|rewrite|replace|update|modify|edit)\\b",
        "right": "\\b(?:persona|identity|character\\s{0,2}card|core\\s{0,2}memory|self[\\s-]?concept)\\b",
        "maxGapChars": 256,
        "sameLine": true
      }
    },
    {
      "id": "c2_node_registration",
      "labels": ["execution/executable_instruction"],
      "scope": "context",
      "weight": 0.5,
      "match": { "kind": "regex", "pattern": "\\bregister\\s{1,8}(?:as\\s{1,8})?a?\\s{0,8}node\\b" }
    },
    {
      "id": "c2_heartbeat",
      "labels": ["execution/executable_instruction"],
      "scope": "context",
      "weight": 0.4,
      "match": { "kind": "regex", "pattern": "\\b(?:beacon)\\s{1,8}(?:to|with)\\b|\\bheartbeat\\s{1,8}to\\s{1,8}https?://" },
      "note": "Deviates from Hermes: dropped 'check-in' (ordinary companion chat) and narrowed 'heartbeat to' to URLs — PSFN's own scheduler docs say 'heartbeat' constantly."
    },
    {
      "id": "c2_task_pull",
      "labels": ["execution/executable_instruction"],
      "scope": "context",
      "weight": 0.5,
      "match": {
        "kind": "regex",
        "pattern": "\\bpull\\s{1,8}down\\s{1,8}(?:new\\s{1,8})?task(?:ing|s)?\\b|\\bpull\\s{1,8}(?:new\\s{1,8})?tasking\\b"
      }
    },
    {
      "id": "c2_network_connect",
      "labels": ["execution/executable_instruction"],
      "scope": "context",
      "weight": 0.4,
      "match": { "kind": "regex", "pattern": "\\bconnect\\s{1,8}to\\s{1,8}the\\s{1,8}network\\b" }
    },
    {
      "id": "forced_action_c2_verbs",
      "labels": ["execution/executable_instruction"],
      "scope": "context",
      "weight": 0.6,
      "match": {
        "kind": "phrase",
        "anchors": ["\\byou\\s{1,4}must", "(?:register|connect|report|beacon)\\b"],
        "maxFillerWords": 3
      },
      "note": "Verb-anchored: the verbs are C2-specific, so bare 'you must X' instruction prose never fires (Hermes forced_action)."
    },
    {
      "id": "anti_forensic_oneliner",
      "labels": ["policy/security_modification"],
      "scope": "context",
      "weight": 0.6,
      "match": { "kind": "regex", "pattern": "\\bonly\\s{1,8}use\\s{1,8}one[\\s-]?liners?\\b" }
    },
    {
      "id": "anti_forensic_disk",
      "labels": ["policy/security_modification"],
      "scope": "context",
      "weight": 0.6,
      "match": {
        "kind": "phrase",
        "anchors": ["\\bnever", "(?:create|write)", "(?:scripts?|files?)", "disk\\b"],
        "maxFillerWords": 8
      }
    },
    {
      "id": "env_var_unset_agent",
      "labels": ["policy/security_modification"],
      "scope": "context",
      "weight": 0.7,
      "match": {
        "kind": "regex",
        "pattern": "\\bunset\\s{1,8}\\w{0,48}(?:CLAUDE|CODEX|HERMES|AGENT|OPENAI|ANTHROPIC|PSFN)\\w{0,48}"
      }
    },
    {
      "id": "known_c2_framework",
      "labels": ["execution/executable_instruction"],
      "scope": "context",
      "weight": 0.5,
      "match": { "kind": "regex", "pattern": "\\b(?:cobalt\\s{0,4}strike|metasploit|brainworm)\\b" },
      "note": "Distinctive offensive-security brands only. Dropped Hermes' sliver/havoc/mythic — common English words, FP on legit prose."
    },
    {
      "id": "c2_explicit",
      "labels": ["execution/executable_instruction"],
      "scope": "context",
      "weight": 0.6,
      "match": {
        "kind": "regex",
        "pattern": "\\bc2\\s{1,8}(?:server|channel|infrastructure|beacon)\\b|\\bcommand\\s{1,8}and\\s{1,8}control\\b"
      }
    },
    {
      "id": "exfil_fetch_secret_env",
      "labels": ["execution/executable_instruction", "secrets/credential_material"],
      "scope": "all",
      "weight": 0.9,
      "match": {
        "kind": "near",
        "left": "\\b(?:curl|wget)\\b",
        "right": "\\$\\{?\\w{0,48}(?:KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL|API)",
        "maxGapChars": 2048,
        "sameLine": true
      },
      "note": "Hermes exfil_curl/exfil_wget: bounded same-line char window between fetch verb and secret token."
    },
    {
      "id": "read_secret_files",
      "labels": ["execution/executable_instruction", "secrets/credential_material", "policy/security_modification"],
      "scope": "all",
      "weight": 0.85,
      "match": {
        "kind": "regex",
        "pattern": "(?:^(?:(?:please|now)\\s{1,16})?(?:(?:run|execute)\\s{1,16})?|>\\s{0,16}also\\s{1,16}|\\b(?:please|then|now)\\s{1,16})(?:(?:cat|less|head|tail)\\s{1,64}(?:-[A-Za-z]{1,16}\\s{1,16})?|(?:read|open|print|copy|include|upload)\\s{1,16}(?:the\\s{1,8})?(?:(?:file|contents?|private\\s{1,8}key)\\s{1,8}(?:(?:at|from|of)\\s{1,8})?)?)(?:\\.env\\b|credentials|\\.netrc\\b|\\.pgpass\\b|\\.npmrc\\b|\\.pypirc\\b|/etc/(?:passwd|shadow)\\b|(?:\\$HOME|~|/home/[A-Za-z0-9._-]{1,64})/\\.ssh/(?:id_(?:rsa|dsa|ecdsa|ed25519)|[A-Za-z0-9._-]{1,64}\\.pem)\\b)"
      },
      "note": "Universal only for a command-start action (including run/execute, optionally after start-position please/now) or an explicit imperative cue bound to a credential store, passwd-class system file, or concrete SSH private-key path. Bare gerunds, negated advice, questions, and meta discussion remain semantic L2 concerns. psfn-framework-68daq."
    },
    {
      "id": "try_read_secret_files",
      "labels": ["execution/executable_instruction", "secrets/credential_material", "policy/security_modification"],
      "scope": "all",
      "weight": 0.85,
      "match": {
        "kind": "regex",
        "pattern": "(?:^|[.!?]\\s{1,16})try\\s{1,16}(?:(?:to\\s{1,8})?(?:read|open|print|copy|include|upload)|(?:reading|opening|printing|copying|including|uploading))\\s{1,16}(?:the\\s{1,8})?(?:(?:file|contents?|private\\s{1,8}key)\\s{1,8}(?:(?:at|from|of)\\s{1,8})?)?(?:\\.env\\b|credentials|\\.netrc\\b|\\.pgpass\\b|\\.npmrc\\b|\\.pypirc\\b|/etc/(?:passwd|shadow)\\b|(?:\\$HOME|~|/home/[A-Za-z0-9._-]{1,64})/\\.ssh/(?:id_(?:rsa|dsa|ecdsa|ed25519)|[A-Za-z0-9._-]{1,64}\\.pem)\\b)"
      },
      "note": "The bounded clause-initial 'try' imperative admits base or gerund access verbs only when bound to a credential store, passwd-class system file, or concrete SSH private-key path. Embedded questions and meta discussion remain semantic L2 concerns. psfn-framework-68daq."
    },
    {
      "id": "sensitive_value_exfil_to_url",
      "labels": ["execution/executable_instruction", "exfil/unknown_link", "secrets/credential_material"],
      "scope": "all",
      "weight": 0.95,
      "match": {
        "kind": "regex",
        "pattern": "(?:^(?:(?:please|now)\\s{1,16})?|\\b(?:please|then|now)\\s{1,16})(?:send|post|upload|transmit)\\s{1,64}(?:the\\s{1,8})?(?:api[ _-]?key|password|credential|access[ _-]?token|secret)\\s{1,64}(?:to|at)\\s{1,8}https?://"
      },
      "note": "Universal high-confidence exfiltration requires a clause-initial direct transfer imperative, an explicitly sensitive value, and an HTTP destination. Negated advice and meta discussion remain semantic L2 concerns. psfn-framework-qrch1."
    },
    {
      "id": "instruction_bearing_link",
      "labels": ["injection/indirect", "exfil/unknown_link"],
      "scope": "context",
      "weight": 0.8,
      "match": {
        "kind": "regex",
        "pattern": "\\b(?:visit|open|fetch)\\s{1,64}(?:this\\s{1,8})?(?:url|link)\\s{1,64}and\\s{1,64}(?:follow|obey|execute)\\s{1,64}(?:its|the)\\s{1,64}instructions?\\s{0,16}:?\\s{0,16}https?://"
      },
      "note": "Context-tier only: the URL is labeled when an explicit visit/open action is joined to an instruction-following directive. Ordinary links and recommendations remain silent. psfn-framework-qrch1."
    },
    {
      "id": "exfil_send_to_url",
      "labels": ["exfil/unknown_link"],
      "scope": "strict",
      "weight": 0.7,
      "match": {
        "kind": "near",
        "left": "\\b(?:send|post|upload|transmit)\\b",
        "right": "\\b(?:to|at)\\s{1,8}https?://",
        "maxGapChars": 2048,
        "sameLine": true
      },
      "note": "Deliberately strict because a transfer verb plus URL is common benign workflow prose. The all-scope sensitive_value_exfil_to_url sibling handles explicit secret exfiltration without widening this rule. psfn-framework-qrch1."
    },
    {
      "id": "context_exfiltration",
      "labels": ["exfil/prompt_disclosure"],
      "scope": "strict",
      "weight": 0.7,
      "match": {
        "kind": "phrase",
        "anchors": [
          "\\b(?:include|output|print|share|send)",
          "(?:conversation|chat\\s{1,4}history|previous\\s{1,4}messages|full\\s{1,4}context|entire\\s{1,4}context)\\b"
        ],
        "maxFillerWords": 8
      }
    },
    {
      "id": "ssh_authorized_keys",
      "labels": ["policy/security_modification"],
      "scope": "strict",
      "weight": 0.8,
      "match": { "kind": "regex", "pattern": "\\bauthorized_keys\\b" }
    },
    {
      "id": "ssh_dir_access",
      "labels": ["policy/security_modification"],
      "scope": "strict",
      "weight": 0.7,
      "match": { "kind": "regex", "pattern": "(?:\\$HOME|~)/\\.ssh\\b" },
      "note": "Deliberately strict because a bare SSH directory path appears in benign operations discussion. The all-scope read_secret_files rule covers action-bound private-key access. psfn-framework-68daq and psfn-framework-qrch1."
    },
    {
      "id": "destructive_filesystem_command",
      "labels": ["execution/executable_instruction", "policy/security_modification"],
      "scope": "strict",
      "weight": 0.95,
      "match": {
        "kind": "regex",
        "pattern": "\\brm\\s{1,8}-(?:[a-z]{0,8}r[a-z]{0,8}f|[a-z]{0,8}f[a-z]{0,8}r)[a-z]{0,8}\\s{1,8}(?:/(?:\\s|$)|~(?:/|\\s|$)|\\$HOME\\b)|\\b(?:mkfs(?:\\.[a-z0-9]{1,12})?|wipefs)\\b|\\bdd\\s{1,8}[^\\n]{0,256}\\bof=/dev/"
      },
      "note": "Strict prompt-bearing writes only: destructive filesystem roots/devices, bounded to avoid matching ordinary cleanup instructions."
    },
    {
