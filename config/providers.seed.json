{
  "schemaVersion": 1,
  "providers": [
    {
      "id": "openrouter",
      "type": "openrouter",
      "enabled": true,
      "label": "OpenRouter",
      "apiBaseUrl": "https://openrouter.ai/api/v1",
      "modelsApiUrl": "https://openrouter.ai/api/v1/models",
      "apiKeyRef": {
        "kind": "env",
        "envName": "OPENROUTER_API_KEY"
      },
      "metadata": {
        "webTools": {
          "enabled": false,
          "model": "openai/gpt-4o-mini"
        }
      }
    },
    {
      "id": "shared-router-example",
      "type": "generic_openai",
      "enabled": false,
      "label": "External shared LLM router example",
      "apiBaseUrl": "https://router.example.test/v1",
      "apiKeyRef": {
        "kind": "env",
        "envName": "SHARED_ROUTER_API_KEY"
      }
    }
  ]
}
