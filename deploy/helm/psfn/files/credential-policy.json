{
  "minimumLength": 32,
  "maximumLength": 512,
  "minimumDistinctCharacters": 12,
  "hmacRotationVersionPattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
  "placeholderPattern": "(?i)(change[_ -]?me|replace[_ -]?me|placeholder|your[_ -].*(key|token|password|secret)|not[_ -]?for[_ -]?production|^default$|^password$)"
}
