[Unit]
Description=PSFN Companion UI LAN Dev Server
After=network-online.target local-fs.target psfn-satellite-hub.service
Wants=network-online.target
Requires=local-fs.target psfn-satellite-hub.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=psfn
Group=psfn
WorkingDirectory=~
Environment=PATH=/opt/node-v22/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/node-v22/bin/npm --prefix ./psfn-framework-source/companion-ui run dev -- --host 0.0.0.0 --port 5173
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=psfn-companion-ui

[Install]
WantedBy=multi-user.target
