[Unit]
Description=PSFN Satellite Hub
After=network-online.target local-fs.target psfn.service
Wants=network-online.target
Requires=local-fs.target psfn.service
RequiresMountsFor=%S/psfn/runtime
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=psfn
Group=psfn
WorkingDirectory=~
Environment=PATH=/opt/node-v22/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/node-v22/bin/npm --prefix ./psfn-satellite-hub run hub:ts
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=psfn-satellite-hub

[Install]
WantedBy=multi-user.target
