FROM node:22-slim AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY tsconfig.json tsup.config.ts ./
COPY src/ ./src/

RUN npm run build

COPY admin-ui/ ./admin-ui/
RUN npm --prefix admin-ui ci && npm --prefix admin-ui run build

# ── Production image ──
FROM node:22-slim

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist/ ./dist/
COPY --from=builder /app/admin-ui/build/ ./admin-ui/build/
COPY scripts/ops/ ./scripts/ops/

RUN mkdir -p /app/data /app/workspace /app/companion-data /app/system-data /app/logs /app/tmp
RUN groupadd -r psfn && useradd -r -g psfn -d /app psfn
RUN chown -R psfn:psfn /app
USER psfn

ENV NODE_ENV=production
ENV GATEWAY_SOCKET=/run/psfn/gateway.sock
ENV DATABASE_PATH=/app/companion-data/psfn.db
ENV DATA_DIR=/app/system-data

CMD ["node", "dist/agent-main.js"]
