FROM postgres:17.6-bookworm@sha256:f3bd19c606e442c3d7bdfa8002e03fe260a1023351e0ea4598032022b68dd6e3 AS postgres-client

RUN set -eux; \
    mkdir -p /opt/postgresql-client/bin /opt/postgresql-client/lib /opt/postgresql-client/wrappers; \
    for binary in pg_dump pg_restore psql pg_isready; do \
      cp "/usr/lib/postgresql/17/bin/${binary}" "/opt/postgresql-client/bin/${binary}"; \
    done; \
    ldd /opt/postgresql-client/bin/pg_dump \
      /opt/postgresql-client/bin/pg_restore \
      /opt/postgresql-client/bin/psql \
      /opt/postgresql-client/bin/pg_isready \
      | awk '$2 == "=>" && $3 ~ /^\// { print $3 }' \
      | sort -u \
      | while read -r library; do cp -L "${library}" /opt/postgresql-client/lib/; done; \
    for binary in pg_dump pg_restore psql pg_isready; do \
      printf '#!/bin/sh\nLD_LIBRARY_PATH=/opt/postgresql-client/lib exec /opt/postgresql-client/bin/%s "$@"\n' "${binary}" > "/opt/postgresql-client/wrappers/${binary}"; \
      chmod 0755 "/opt/postgresql-client/wrappers/${binary}"; \
    done

FROM node:24.13.1-slim@sha256:a81a03dd965b4052269a57fac857004022b522a4bf06e7a739e25e18bce45af2 AS native-toolchain

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      g++=4:12.2.0-3 \
      make=4.3-4.1 \
      python3=3.11.2-1+b1 \
    && rm -rf /var/lib/apt/lists/*

FROM native-toolchain AS build

COPY package*.json ./
COPY admin-ui/package*.json ./admin-ui/
RUN npm_config_nodedir=/usr/local npm ci

COPY tsconfig.json tsconfig.companion-id-types.json tsup.config.ts ./
COPY type-tests/companion-id.type-test.ts ./type-tests/
COPY src/ ./src/
COPY scripts/preflight-startup-owner-files.ts ./scripts/preflight-startup-owner-files.ts
COPY scripts/preflight-owner-file-modes.ts ./scripts/preflight-owner-file-modes.ts
COPY scripts/provision-injection-model.ts ./scripts/provision-injection-model.ts
COPY admin-ui/ ./admin-ui/

# Contract-surface hash for per-component rollout skew detection: agent and
# gateway may run different image tags ONLY while this hash matches. The
# surface is the shared contracts plus the boundary (gateway RPC/policy) layer.
RUN find src/shared/contracts src/boundary -type f -name '*.ts' ! -name '*.test.ts' \
      | LC_ALL=C sort | xargs sha256sum | sha256sum | cut -c1-16 > /app/contract-hash.txt \
    && cat /app/contract-hash.txt

RUN npm run build
RUN npm run garden:build

FROM native-toolchain AS production-deps

WORKDIR /app

COPY package*.json ./
COPY admin-ui/package*.json ./admin-ui/
RUN npm_config_nodedir=/usr/local npm ci --omit=dev \
    && rm -rf /root/.npm /app/admin-ui/node_modules

FROM node:24.13.1-slim@sha256:a81a03dd965b4052269a57fac857004022b522a4bf06e7a739e25e18bce45af2 AS runtime

WORKDIR /app

# Sandbox CLI toolset (psfn-framework-jdwd). The bubblewrap sandbox has no
# network, so every analysis capability the companion can use must ship in the
# image. Chosen set, kept deliberately small (~200 MB installed, pandoc and
# poppler dominating):
#   bubblewrap        OS-enforced sandbox boundary (mandatory)
#   git               repo inspection inside /workspace and the /repo mount
#   ripgrep           fast bounded text search over large documents
#   jq                JSON slicing without loading whole files into context
#   file              type detection before choosing an extraction tool
#   unzip/zip         archives; docx/xlsx/odt containers are zip files
#   sqlite3           local structured-data analysis (CSV import, queries)
#   poppler-utils     pdftotext/pdfinfo for PDF handoff
#   pandoc            docx/odt/html/epub -> text/markdown conversion
#   python3 (+venv)   companion-authored analysis scripts; stdlib covers
#                     csv/json/sqlite3/zipfile/statistics without network
#   uv                fast script/venv runner (offline-capable against local
#                     wheels; network installs are intentionally impossible
#                     inside the sandbox)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bubblewrap=0.8.0-2+deb12u1 \
      file=1:5.44-3 \
      git=1:2.39.5-0+deb12u3 \
      jq=1.6-2.1+deb12u2 \
      pandoc=2.17.1.1-2~deb12u1 \
      poppler-utils=22.12.0-2+deb12u2 \
      python3=3.11.2-1+b1 \
      python3-venv=3.11.2-1+b1 \
      ripgrep=13.0.0-4+b2 \
      sqlite3=3.40.1-2+deb12u2 \
      unzip=6.0-28 \
      zip=3.0-13 \
    && npm install -g @beads/bd@1.1.0 \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

# uv: exact version pinned by immutable multi-arch index digest.
COPY --from=ghcr.io/astral-sh/uv:0.11.30@sha256:93b61e21202b1dab861092748e46bbd6e0e41dd84f59b9174efd2353186e1b47 /uv /uvx /usr/local/bin/

COPY package*.json ./
COPY admin-ui/package*.json ./admin-ui/
COPY --from=production-deps /app/node_modules/ ./node_modules/

COPY --from=postgres-client /opt/postgresql-client/ /opt/postgresql-client/
COPY --from=build /app/dist/ ./dist/
COPY --from=build /app/contract-hash.txt ./contract-hash.txt
COPY --from=build /app/admin-ui/build/ ./admin-ui/build/
COPY config/*.seed.json ./config/
COPY config/intake-l1-rules.json ./config/intake-l1-rules.json
COPY deploy/helm/psfn/ ./deploy/helm/psfn/
COPY scripts/ops/ ./scripts/ops/
# Repo-root skills tree: the skills runtime scans <repoRoot>/skills at
# runtime (repoRoot = /app in the image); without this COPY the global
# skills root is missing and the loader reports it as absent.
COPY skills/ ./skills/
RUN find /app/skills -type f -name SKILL.md -print -quit | grep -q .

# Companion-library seed bundle (psfn-framework-o3wwr): provisionFleetWorkspaces()
# -> seedCompanionLibrary() reads this bundle UNCONDITIONALLY at gateway boot from
# resolve('companion_docs') = /app/companion_docs (WORKDIR /app). Baking it here is
# unconditional and so matches the unconditional runtime requirement; the runtime
# verifies each file against the manifest's SHA-256 digests, so the bundle must be
# the byte-identical checked-in source. Without this COPY the gateway crashes on
# boot with "Invalid Companion Library source manifest .../companion-library-manifest.json: ENOENT".
COPY companion_docs/ ./companion_docs/
# Fail the build (not gateway boot) if any file the runtime seeds is missing from
# the context. The manifest alone is insufficient: a dropped .md would pass a
# manifest-only check and only surface later as a runtime SHA-256/strict-dir throw.
RUN set -eu; for f in \
      companion-library-manifest.json \
      welcome.md \
      privacy-boundary-reference.md \
      live_verification_checklist.md; do \
      test -f "/app/companion_docs/${f}"; \
    done

RUN git init /app \
    && git config user.name "PSFN Runtime Image" \
    && git config user.email "runtime-image@psfn.local" \
    && git config --system --add safe.directory /app \
    && printf 'node_modules/\nadmin-ui/node_modules/\n' > .gitignore \
    && git add .gitignore package*.json admin-ui/package*.json dist admin-ui/build config deploy/helm/psfn scripts/ops skills \
    && git commit -m "Runtime image snapshot"

# Non-root user for defense in depth. Keep the numeric ID aligned with the
# Kubernetes securityContext so runAsNonRoot can be verified at admission time.
RUN groupadd -r -g 999 psfn && useradd -r -u 999 -g psfn -d /app psfn
RUN mkdir -p \
      /app/backups \
      /app/companion-data \
      /app/data \
      /app/logs \
      /app/runtime-root \
      /app/system-data \
      /app/tmp \
      /app/workspace \
      /run/psfn \
    && chown -R psfn:psfn \
      /app/.git \
      /app/backups \
      /app/companion-data \
      /app/data \
      /app/logs \
      /app/runtime-root \
      /app/system-data \
      /app/tmp \
      /app/workspace \
      /run/psfn
USER 999:999

# Build provenance for companion self-diagnosis (self_status action=diagnose).
# CD should pass the real source commit(s); helm env overrides these at pod
# level. Empty defaults are reported as "unavailable" (fail-closed).
ARG PSFN_GIT_COMMIT=""
ARG PSFN_PREVIOUS_GIT_COMMIT=""
ENV PSFN_GIT_COMMIT=${PSFN_GIT_COMMIT}
ENV PSFN_PREVIOUS_GIT_COMMIT=${PSFN_PREVIOUS_GIT_COMMIT}
ENV NODE_ENV=production
ENV PATH=/opt/postgresql-client/wrappers:$PATH
ENV GATEWAY_SOCKET=/run/psfn/gateway.sock
ENV PSFN_RUNTIME_ROOT=/app/runtime-root
ENV SYSTEM_DATA_DIR=/app/system-data
ENV COMPANION_DATA_DIR=/app/companion-data
ENV WORKSPACE_PATH=/app/workspace
ENV PSFN_LOGS_DIR=/app/logs
ENV PSFN_TEMP_DIR=/app/tmp
ENV BACKUP_ROOT_DIR=/app/backups

CMD ["node", "dist/agent-main.js"]
