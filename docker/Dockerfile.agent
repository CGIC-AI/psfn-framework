FROM node:22-slim

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --omit=dev

# Copy compiled output
COPY dist/ ./dist/

# Agent data directories
RUN mkdir -p /app/data /app/workspace

# Non-root user for defense in depth
RUN groupadd -r psfn && useradd -r -g psfn -d /app psfn
RUN chown -R psfn:psfn /app
USER psfn

ENV NODE_ENV=production
ENV GATEWAY_SOCKET=/run/psfn/gateway.sock
ENV DATABASE_PATH=/app/data/purrsephone.db
ENV DATA_DIR=/app/data

CMD ["node", "dist/agent-main.js"]
