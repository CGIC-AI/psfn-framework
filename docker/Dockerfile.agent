FROM node:22.22.2-slim@sha256:9f6d5975c7dca860947d3915877f85607946403fc55349f39b4bc3688448bb6e

WORKDIR /app

# Install dependencies
COPY package*.json ./
COPY admin-ui/package*.json ./admin-ui/
RUN npm ci --omit=dev

# Copy compiled output
COPY dist/ ./dist/

# Agent data directories
RUN mkdir -p /app/data /app/workspace

# Non-root user for defense in depth
RUN groupadd -r psfn && useradd -r -g psfn -d /app psfn
RUN chown -R psfn:psfn /app
USER psfn

ENV NODE_ENV=production
ENV GATEWAY_SOCKET=/run/psfn/gateway.sock
ENV DATABASE_PATH=/app/data/psfn.db
ENV DATA_DIR=/app/data

CMD ["node", "dist/agent-main.js"]
