FROM node:22-slim AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY tsconfig.json tsup.config.ts ./
COPY src/ ./src/

RUN npm run build

# ── Production image ──
FROM node:22-slim

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist/ ./dist/

RUN mkdir -p /run/psfn /app/system-data
RUN groupadd -r psfn && useradd -r -g psfn -d /app psfn
RUN chown -R psfn:psfn /app /run/psfn
USER psfn

ENV NODE_ENV=production
ENV GATEWAY_SOCKET=/run/psfn/gateway.sock

CMD ["node", "dist/gateway-main.js"]
