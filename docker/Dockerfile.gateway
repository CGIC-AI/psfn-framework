FROM node:22-slim

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY dist/ ./dist/
COPY config/ ./config/

RUN mkdir -p /run/psfn /app/system-data
RUN groupadd -r psfn && useradd -r -g psfn -d /app psfn
RUN chown -R psfn:psfn /app /run/psfn
USER psfn

ENV NODE_ENV=production
ENV GATEWAY_SOCKET=/run/psfn/gateway.sock

CMD ["node", "dist/gateway-main.js"]
