    BEADSOPS["BeadsOps / GatewayBeadsOps<br/><i>issue tracker: ready, show, create,<br/>update, close, sync</i>"]
    FSOPS["FilesystemOps / GatewayFilesystemOps<br/><i>file read / write / list tools</i>"]
    IMGOPS["ImageOps / GatewayImageOps<br/><i>ComfyUI / Fal.ai generation,<br/>vision reviewer</i>"]
  end

