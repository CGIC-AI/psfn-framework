---
title: "PSFN Substrate Framework — Architecture"
---
graph TB
  %% ═══════════════════════════════════════════════
  %% ENTRY POINTS
  %% ═══════════════════════════════════════════════
  subgraph Entry["Entry Points"]
    direction LR
    IDX["index.ts<br/><i>Disabled — monolithic unavailable</i>"]
    GWM["gateway-main.ts<br/><i>Host process — holds secrets + external egress</i>"]
    AGM["agent-main.ts<br/><i>Container process — network-isolated</i>"]
  end

  %% ═══════════════════════════════════════════════
  %% BOOTSTRAP LAYER
  %% ═══════════════════════════════════════════════
  subgraph Bootstrap["Bootstrap & Composition"]
    COMP["composition.ts<br/><i>composeIdentity, composeSubstrateAgent,<br/>composeSessionRuntime, wireMemoryRuntime,<br/>wireShardAndThinkRuntime, wireSelfModelRuntime</i>"]
    PARITY["parity.ts<br/><i>wirePromptRuntime, wireHeartbeatRuntime,<br/>wireSettingsRuntime, wireSessionToolsRuntime,<br/>wireFilesystemToolsRuntime, wireContactRuntime</i>"]
    POSTACT["post-turn-actions.ts<br/><i>deferred action queue + dispatch</i>"]
    CHANRT["channel-runtime.ts<br/><i>Discord / Telegram / OpenHome / API factory entries</i>"]
  end

  IDX --> LIFECYCLE
  GWM --> GWS
  GWM --> DISCORD
  GWM --> TELEGRAM
  GWM --> WYTCP
  AGM --> GWC
  AGM --> COMP
  AGM --> PARITY
  RT --> COMP
  RT --> PARITY
  RT --> EB
  COMP --> SMAN
  COMP --> SA
  COMP --> MRET
  COMP --> MEXT
  COMP --> SMGR
  PARITY --> PLSTORE
  PARITY --> HBEAT
  PARITY --> SKILLS
  PARITY --> VALUES
  POSTACT --> SA

  %% ═══════════════════════════════════════════════
  %% RUNTIME CORE
  %% ═══════════════════════════════════════════════
  subgraph Core["Runtime Core"]
    RT["SubstrateRuntime<br/><i>Single-process lifecycle: init / start / stop</i>"]
    EB["EventBus<br/><i>Typed events: turns, tools, streams,<br/>heartbeat, model budget, capabilities</i>"]
    LIFECYCLE["Lifecycle<br/><i>RuntimeMode contract, LifecycleNotifier,<br/>turn contention, pre-restart / ready / shutdown</i>"]
  end

  LIFECYCLE --> DISCORD

  %% ═══════════════════════════════════════════════
  %% GATEWAY  (host-side process)
  %% ═══════════════════════════════════════════════
  subgraph Gateway["Gateway (Host-Side Process)"]
    GWS["GatewayServer<br/><i>JSON-RPC 2.0 bidirectional</i>"]
    POLICY["Policy Engine<br/><i>ALLOW / NEEDS_APPROVAL / DENY</i>"]
    SSRF["URL Policy + SSRF Defense<br/><i>lane-based allowlists: discovery / crawler</i>"]
    SANITIZE["Content Sanitizer<br/><i>structural → pattern → tagging</i>"]
    GWAUDIT["AuditStore<br/><i>SQLite gateway audit log</i>"]
    TRANSPORT["NdjsonConnection<br/><i>Unix socket NDJSON transport</i>"]
    NTFY["ntfy Notifier<br/><i>notify_operator push notifications</i>"]
    CONFQUEUE["ConfirmationQueue<br/><i>operator-confirmable queued actions</i>"]
  end

  GWS --> POLICY
  GWS --> SSRF
  GWS --> SANITIZE
  GWS --> GWAUDIT
  GWS --> TRANSPORT
  GWS --> NTFY
  GWS --> CONFQUEUE
  GWS --> LLMC
  NTFY --> NTFYSVC

  %% ═══════════════════════════════════════════════
  %% AGENT  (container-side)
  %% ═══════════════════════════════════════════════
  subgraph AgentSide["Agent (Container-Side)"]
    GWC["GatewayClient<br/><i>implements LLMProvider + EmbeddingService<br/>HMAC session integrity, keep-alive</i>"]
  end

  GWC <-->|"NDJSON Unix Socket<br/>/run/psfn/gateway.sock"| TRANSPORT

  %% ═══════════════════════════════════════════════
  %% AGENT SYSTEM
  %% ═══════════════════════════════════════════════
  subgraph AgentSystem["Agent System"]
    SA["SubstrateAgent<br/><i>wraps pi-agent-core Agent<br/>tool registry (core / extended),<br/>capability gate, adaptive telemetry</i>"]
    BRIDGE["EventBridge<br/><i>pi-agent-core events → EventBus</i>"]
    MSGS["AgentMessages<br/><i>convertToLlm(): compaction,<br/>observation masking, continuity</i>"]
    STREAM["StreamAdapter<br/><i>model slot resolution,<br/>runtime stream options</i>"]
    BGQUEUE["Background Completion Queue<br/><i>deferred turn completions,<br/>background continuation policy</i>"]
  end

  SA --> BRIDGE
  SA --> MSGS
  SA --> STREAM
  SA --> BGQUEUE
  BRIDGE --> EB
  SA --> EB
  SA -->|"memoryProvider"| MRET
  SA -->|"memoryExtractor"| MEXT
  SA -->|"promptComposer"| PCOMPOSE
  SA --> SMAN
  SA --> CONTACT
  SA --> CAPRT
  SA --> EMSTATE
  SA --> EMOBS
  SA --> EMAPPR
  SA --> INTSTATE
  SA --> INTAPPR
  SA --> THINK
  SA -->|"spawn_shard"| SMGR
  STREAM --> GWC
  STREAM --> LLMC

  %% ═══════════════════════════════════════════════
  %% LLM LAYER
  %% ═══════════════════════════════════════════════
  subgraph LLM["LLM Layer"]
    LLMC["LLMClient<br/><i>stream() + complete()<br/>retry + fallback + budget</i>"]
    MODELS["Model Roster<br/><i>ModelSlot, ModelPurpose,<br/>resolveModelSlot()</i>"]
    DISC["ModelDiscovery<br/><i>LiteLLM + OpenRouter /v1/models</i>"]
    BUDGET["ModelBudget<br/><i>per-model budget enforcement</i>"]
    DELIB["Deliberation<br/><i>values + heartbeat LLM calls</i>"]
  end

  LLMC --> MODELS
  LLMC --> BUDGET
  LLMC --> LITELLM
  DISC --> LITELLM
  DELIB --> LLMC

  %% ═══════════════════════════════════════════════
  %% MEMORY SYSTEM
  %% ═══════════════════════════════════════════════
  subgraph Memory["Memory System"]
    MSTORE["MemoryStore<br/><i>SQLite + sqlite-vec, 6 memory types,<br/>vector similarity + lexical search, scratchpad</i>"]
    MRET["MemoryRetriever<br/><i>composite: vector + recency + salience +<br/>VAD mood congruence + trust-gated</i>"]
    MEXT["MemoryExtractor<br/><i>LLM extraction → XML parse,<br/>quality gates, crash recovery</i>"]
    MWRITE["MemoryWriter<br/><i>dedup + contradiction logic</i>"]
    DECAY["SalienceDecay<br/><i>exponential per-type half-lives</i>"]
    EMBED["EmbeddingProvider<br/><i>Ollama — snowflake-arctic-embed2 (1024d)</i>"]
    SLEEPTIME["SleeptimeMemoryAgent<br/><i>idle consolidation — LLM synthesis</i>"]
    MEMJRNL["MemoryJournal<br/><i>append-only JSONL mutation audit</i>"]
  end

  MRET --> MSTORE
  MRET --> EMBED
  MRET -->|"trust-gated retrieval"| TPOLICY
  MEXT --> MWRITE
  MEXT --> PREG
  MWRITE --> MSTORE
  MWRITE --> EMBED
  MWRITE --> MEMJRNL
  DECAY --> MSTORE
  EMBED --> OLLAMA
  SLEEPTIME --> MWRITE
  SLEEPTIME --> LLMC
  MSTORE --> SQLITE
  MEMJRNL --> JSONLFS
  PATTERNS --> MWRITE

  %% ═══════════════════════════════════════════════
  %% SESSION SYSTEM
  %% ═══════════════════════════════════════════════
  subgraph Sessions["Session System"]
    SSTORE["SessionStore<br/><i>per-channel JSONL, append-only L0,<br/>crash recovery, channel index</i>"]
    SMAN["SessionManager<br/><i>buildContext(), auto-compaction,<br/>token budget, observation masking,<br/>focus knowledge, core memory injection</i>"]
    UCONT["UserContinuityStore<br/><i>per-user cross-channel JSONL</i>"]
    COMPGD["CompressionGuideline<br/><i>self-improving compaction instructions</i>"]
    FOCUS["FocusKnowledge<br/><i>active study/focus integration</i>"]
    IROLE["InternalRoleEnvelopes<br/><i>per-channel JSONL ledger:<br/>Whisper notes, system annotations</i>"]
  end

  SMAN --> SSTORE
  SMAN --> UCONT
  SMAN --> COMPGD
  SMAN --> FOCUS
  SMAN --> COREMEM
  SMAN --> PREG
  MSGS --> SMAN
  SSTORE --> JSONLFS
  UCONT --> JSONLFS
  IROLE --> JSONLFS

  %% ═══════════════════════════════════════════════
  %% IDENTITY & PROMPTS
  %% ═══════════════════════════════════════════════
  subgraph Identity["Identity & Prompts"]
    CARD["Character Card Loader<br/><i>V2 spec JSON</i>"]
    CARDVER["CharacterCardVersionStore<br/><i>JSONL version history + persona_update tool</i>"]
    PLSTORE["PromptLayerStore<br/><i>JSON + JSONL history, 5 layer types,<br/>create / update / rollback / toggle</i>"]
    PCOMPOSE["PromptComposer<br/><i>context-aware filtering, SHA-256 hash,<br/>constitution + values + north-star layers</i>"]
    PREG["PromptRegistryStore<br/><i>keyed runtime prompts: extraction,<br/>compaction, deliberation call-sites</i>"]
    NORTHSTAR["NorthStarStore<br/><i>companion goals, injected into prompt</i>"]
    COREMEM["CoreMemoryStore<br/><i>fixed-size JSON, injected into context</i>"]
  end

  CARD --> PLSTORE
  CARDVER --> CARD
  PCOMPOSE --> PLSTORE
  PCOMPOSE --> NORTHSTAR
  PLSTORE --> JSONLFS
  PREG --> JSONLFS
  COREMEM --> JSONFILES
  NORTHSTAR --> JSONFILES

  %% ═══════════════════════════════════════════════
  %% EMOTION & AFFECT
  %% ═══════════════════════════════════════════════
  subgraph Emotion["Emotion & Affect"]
    EMSTATE["EmotionState<br/><i>VAD: valence-arousal-dominance,<br/>mood EMA, discrete emotions,<br/>joy / anger / sadness / surprise / love</i>"]
    EMOBS["EmotionObserver<br/><i>text + audio emotion observations</i>"]
    TXTCLS["Text Emotion Classifier<br/><i>transformers ML</i>"]
    AUDCLS["Audio Emotion Classifier<br/><i>audio ML</i>"]
    PERSONA["PersonaAdaptation<br/><i>honne / tatemae per trust tier</i>"]
    EMAPPR["EmotionAppraisal<br/><i>per-turn appraisal entries</i>"]
  end

  EMOBS --> EMSTATE
  EMOBS --> TXTCLS
  EMOBS --> AUDCLS
  EMSTATE --> PERSONA
  EMAPPR --> EMSTATE

  %% ═══════════════════════════════════════════════
  %% SELF-MODEL & METACOGNITION
  %% ═══════════════════════════════════════════════
  subgraph SelfModel["Self-Model & Metacognition"]
    INTSTATE["InternalState<br/><i>4 dimensions: emotional + cognitive +<br/>attention + relational</i>"]
    META["MetacognitionFlags<br/><i>confidence levels + evidence</i>"]
  end

  INTSTATE --> EMSTATE
  INTSTATE --> META
  INTSTATE --> CONCERNS
  INTSTATE --> FOLLOWUPS

  %% ═══════════════════════════════════════════════
  %% INTENTION & ACTIVE CONCERNS
  %% ═══════════════════════════════════════════════
  subgraph Intention["Intention & Active Concerns"]
    INTAPPR["IntentionAppraisal<br/><i>post-turn: followUp / concern / schedule / noop<br/>LLM + emotion + context + contacts</i>"]
    CONCERNS["ActiveConcerns<br/><i>SQLite: open / pending / resolved,<br/>priorities + due dates</i>"]
    FOLLOWUPS["PendingFollowUps<br/><i>immediate / soon / scheduled</i>"]
    MOTIV["MotivationBridge<br/><i>appraisal decisions → heartbeat / scheduler</i>"]
    PATTERNS["BehavioralPatterns<br/><i>tracks + promotes patterns to long-term memory</i>"]
  end

  INTAPPR --> LLMC
  INTAPPR --> EMSTATE
  INTAPPR --> SMAN
  INTAPPR --> CONTACT
  INTAPPR --> CONCERNS
  INTAPPR --> FOLLOWUPS
  INTAPPR --> MOTIV
  MOTIV --> SCHEDULER
  CONCERNS --> SQLITE
  FOLLOWUPS --> SQLITE

  %% ═══════════════════════════════════════════════
  %% TRUST & CONTACTS
  %% ═══════════════════════════════════════════════
  subgraph Trust["Trust & Contacts"]
    TPOLICY["Trust Policy<br/><i>5-layer: operator → consent →<br/>trust → visibility → default</i>"]
    CONTACT["ContactStore<br/><i>SQLite — identity linking, social graph,<br/>challenge / verify, mutation audit</i>"]
    CHANVIS["ChannelVisibility<br/><i>private / semi_private / public / broadcast</i>"]
  end

  TPOLICY --> CONTACT
  TPOLICY --> CHANVIS
  CONTACT --> SQLITE

  %% ═══════════════════════════════════════════════
  %% CAPABILITIES & SAFEGUARDS
  %% ═══════════════════════════════════════════════
  subgraph Capabilities["Capabilities & Safeguards"]
    CAPRT["CapabilityRuntime<br/><i>tier loaded from capability-tier.json</i>"]
    ELIGATE["EligibilityGate<br/><i>ALLOW / DENY with reason codes,<br/>capability tokens + tier checks</i>"]
    SAFEGUARDS["Safeguards<br/><i>identity cooling-off, restart guard,<br/>comms rate limiter — JSONL audit</i>"]
  end

  CAPRT --> ELIGATE
  SA --> ELIGATE
  SAFEGUARDS --> JSONLFS

  %% ═══════════════════════════════════════════════
  %% REPL SANDBOX
  %% ═══════════════════════════════════════════════
  subgraph REPL["REPL / Think Sandbox"]
    THINK["think / sub_think tools<br/><i>budget-limited reasoning</i>"]
    SANDBOX["node:vm Sandbox<br/><i>print, llm_query, memory_search,<br/>memory_count, session_messages, FINAL</i>"]
    EVIDENCE["Evidence Tracking<br/><i>ThinkEvidence + ThinkStep</i>"]
  end

  THINK --> SANDBOX
  SANDBOX --> EVIDENCE
  SANDBOX --> MRET
  SANDBOX --> SMAN
  SANDBOX --> LLMC

  %% ═══════════════════════════════════════════════
  %% SHARDS
  %% ═══════════════════════════════════════════════
  subgraph Shards["Self-Spawning Shards"]
    SMGR["ShardManager<br/><i>max 5 concurrent, depth=1</i>"]
    SHARD["Shard Instance<br/><i>ephemeral SubstrateAgent<br/>channelId: shard:uuid, shared LLM/memory</i>"]
  end

  SMGR --> SHARD

  %% ═══════════════════════════════════════════════
  %% CHANNEL ADAPTERS
  %% ═══════════════════════════════════════════════
  subgraph Channels["Channel Adapters"]
    DISCORD["DiscordAdapter<br/><i>discord.js — text + voice,<br/>typing indicators, backfill, steering</i>"]
