    REFLJRNL["ReflectionJournal<br/><i>JSONL heartbeat reflection outputs</i>"]
    SKILLS["SkillsRuntime<br/><i>SKILL.md discovery + tools</i>"]
    VALUES["ValuesJournal<br/><i>JSONL + LLM deliberation</i>"]
  end

