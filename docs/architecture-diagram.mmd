  FSOPS -.->|"gateway-backed in split mode"| GWC
  IMGOPS -.->|"gateway-backed in split mode"| GWC
  GITOPS --> JSONLFS
  VAULTOPS --> OBSIDIAN
  IMGOPS --> COMFYUI

  %% ═══════════════════════════════════════════════
  %% PERSISTENCE & CONFIGURATION
  %% ═══════════════════════════════════════════════
  subgraph Persist["Persistence & Configuration"]
    LAYOUT["PersistenceLayout<br/><i>two-root topology: system-data + companion-data,<br/>fail-closed path resolution</i>"]
    SETTCON["SettingsContract<br/><i>owner-file map: settings.json, models.json,<br/>capability-tier.json, channels.json, etc.</i>"]
    BACKUP["BackupSystem<br/><i>scheduled + retention rotation (rotating/weekly/monthly),<br/>startup integrity checks</i>"]
    MODULES["ModuleLoader<br/><i>runtime module registry,<br/>additional tool registration</i>"]
  end

  LAYOUT --> SETTCON
  SETTCON --> JSONFILES
  BACKUP --> JSONLFS
  MODULES --> SA

