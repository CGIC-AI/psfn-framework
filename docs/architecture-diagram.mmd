  SCHEDULER --> DECAY
  SCHEDULER --> HBEAT
  SCHEDULER --> BACKUP
  HBEAT --> REFLJRNL
  HBEAT --> SA
  REFLJRNL --> JSONLFS
  VALUES --> JSONLFS
  VALUES --> DELIB

