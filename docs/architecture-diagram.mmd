  %% SELF-MODIFICATION TOOLS
  %% ═══════════════════════════════════════════════
  subgraph SelfMod["Self-Modification Tools"]
    GITOPS["GitOps / GatewayGitOps<br/><i>6 tools: status, diff, patch,<br/>commit, branch, PR + JSONL audit</i>"]
