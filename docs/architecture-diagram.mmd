flowchart TB
  %% Current PSFN runtime topology. Last updated 2026-06-29.

  subgraph External["External surfaces"]
    DISCORD["Discord text/voice"]
    TELEGRAM["Telegram"]
    API["OpenAI-compatible API"]
    VOICE["WebSocket voice / Satellite Hub"]
    GARDEN_BROWSER["Garden browser"]
  end

  subgraph Gateway["Gateway process - src/app/gateway/main.ts"]
    GW_RPC["GatewayServer\nNDJSON JSON-RPC socket"]
    LLM["LLM + embedding clients\nprovider secrets stay here"]
    POLICY["Gateway policy\nURL/SSRF/fs/shell/git/web/media"]
    CHANNELS["Channel adapters\nDiscord, Telegram, API, voice, Satellite Hub claims"]
    HOST_TOOLS["Privileged host tools\nfs, repo, shell, web, vault, beads, media"]
  end

  subgraph Operator["Operator process - src/app/operator/main.ts"]
    GARDEN_HTTP["Garden HTTP/UI\n/, /memory, /settings, /api/admin/*"]
    ADMIN_PROXY["Private admin transport proxy"]
  end

  subgraph Agent["Agent process - src/app/agent/main.ts"]
    AGENT_LOOP["SubstrateAgent\nprompt/context/tool loop"]
    SESSION["SessionManager\nL0 JSONL context"]
    MEMORY["Memory runtime\nPostgres + pgvector"]
    EPISODIC["L0.1 episodic runtime\nepisodes, spans, arcs, lineage"]
    SCHED["Scheduler\nheartbeat, reflection, backups, rest-window work"]
    IDENTITY["Identity + prompt stack\ncharacter card, layers, north star"]
    TOOLS["Model-facing tools\ntool_search, toolset, memory, orient, wiki, journal, subagent"]
    WORKERS["Subagent + shard internals\nbounded workers, fold-back review"]
    ADMIN_PRIVATE["Private admin surface"]
  end

  subgraph Storage["Persistence and owner roots"]
    PG[("PostgreSQL 16+/17 + pgvector\nruntime state")]
    JSONL[("Session JSONL\ncanonical L0 archive")]
    OWNER[("JSON owner files\nsettings/models/providers/scheduler/capability/trust/charge/backup/skills/channels")]
    WORKSPACE[("WORKSPACE_PATH\npersonal files, wiki, generated media, authored skills")]
    BACKUPS[("Encrypted backups\npg_dump + companion tree + workspace + system config")]
  end

  DISCORD --> CHANNELS
  TELEGRAM --> CHANNELS
  API --> CHANNELS
  VOICE --> CHANNELS
  GARDEN_BROWSER --> GARDEN_HTTP

  CHANNELS --> GW_RPC
  HOST_TOOLS --> POLICY
  GW_RPC <--> AGENT_LOOP
  AGENT_LOOP --> LLM
  AGENT_LOOP --> POLICY
  GARDEN_HTTP --> ADMIN_PROXY
  ADMIN_PROXY <--> ADMIN_PRIVATE

  AGENT_LOOP --> SESSION
  AGENT_LOOP --> MEMORY
  AGENT_LOOP --> EPISODIC
  AGENT_LOOP --> SCHED
  AGENT_LOOP --> IDENTITY
  AGENT_LOOP --> TOOLS
  AGENT_LOOP --> WORKERS

  MEMORY --> PG
  EPISODIC --> PG
  SCHED --> PG
  SESSION --> JSONL
  IDENTITY --> OWNER
  GARDEN_HTTP --> OWNER
  TOOLS --> WORKSPACE
  SCHED --> BACKUPS
  BACKUPS --> PG
  BACKUPS --> JSONL
  BACKUPS --> OWNER
  BACKUPS --> WORKSPACE
