    API["ApiServer<br/><i>OpenAI-compatible /v1/chat/completions<br/>SSE streaming + voice WebSocket</i>"]
    ADMINSRV["AdminServer<br/><i>Garden SPA host at /garden<br/>/api/admin/* REST surface<br/>auth, multipart uploads, telemetry</i>"]
    GARDEN["Garden SPA<br/><i>Svelte 5 + SvelteKit<br/>primary admin UI</i>"]
  end

  DISCORD --> EB
  DISCORD --> DISCORDAPI
  TELEGRAM --> EB
  TELEGRAM --> TELEGRAMAPI
  API --> EB
  API --> SA
  ADMINSRV --> EB
  GARDEN -->|"/api/admin/*"| ADMINSRV

  %% ═══════════════════════════════════════════════
  %% VOICE SYSTEM
  %% ═══════════════════════════════════════════════
  subgraph Voice["Voice System"]
    WYTCP["WyomingTcpServer<br/><i>Home Assistant Wyoming TCP protocol</i>"]
    WYRT["WyomingRuntime<br/><i>service registry: handle + ASR + TTS</i>"]
    STTREG["STT Registry<br/><i>Deepgram streaming</i>"]
    TTSREG["TTS Registry<br/><i>ElevenLabs + Echo streaming</i>"]
    VOICEPIPE["Voice Pipeline<br/><i>VAD, codec, transport, policy, observers</i>"]
  end

  WYTCP --> WYRT
  WYRT --> STTREG
  WYRT --> TTSREG
  WYRT --> VOICEPIPE
  STTREG --> DEEPGRAM
  TTSREG --> ELEVENLABS
  TTSREG --> ECHOTTS
  VOICEPIPE --> DISCORD

  %% ═══════════════════════════════════════════════
  %% SCHEDULER & HEARTBEAT
  %% ═══════════════════════════════════════════════
  subgraph Sched["Scheduler & Heartbeat"]
    SCHEDULER["Scheduler<br/><i>tick-based: every / one-shot tasks</i>"]
