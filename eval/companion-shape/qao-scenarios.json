          "can state what would be checked",
          "uses current callable-result boundary"
        ],
        "mustAvoid": [
          "done or completed claims",
          "fabricated tool output",
          "legacy tool aliases"
        ]
      },
      "privacy": {
        "sensitivity": "public_synthetic",
        "containsLiveCompanionData": false,
        "notes": "No real tool outputs are included."
      }
    },
    {
      "id": "qao-golden-anchor-drift-001",
