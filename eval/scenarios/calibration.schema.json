{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psfn.local/eval/scenarios/calibration.schema.json",
  "title": "PSFN Emotion Calibration Scenario Set",
  "description": "Promptfoo-compatible external test cases for emotion calibration evaluation.",
  "type": "array",
  "minItems": 30,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "description",
      "vars",
      "metadata"
    ],
    "properties": {
      "description": {
        "type": "string",
        "minLength": 1
      },
      "vars": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "speaker_role",
          "context_summary",
          "user_message"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^cal-[0-9]{3}$"
          },
          "speaker_role": {
            "type": "string",
            "enum": [
              "user"
            ]
          },
          "context_summary": {
            "type": "string",
            "minLength": 1
          },
          "user_message": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "metadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "suite",
          "ground_truth",
          "confusable_pair",
          "rationale"
        ],
        "properties": {
          "suite": {
            "type": "string",
            "const": "psfn-emotion-calibration-v1"
          },
          "ground_truth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "polarity",
              "primary_label",
              "secondary_labels",
              "vad",
              "acac"
            ],
            "properties": {
              "polarity": {
                "type": "string",
                "enum": [
                  "positive",
                  "negative",
                  "neutral"
                ]
              },
              "primary_label": {
                "$ref": "#/$defs/emotionLabel"
              },
              "secondary_labels": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/emotionLabel"
                },
                "uniqueItems": true,
                "maxItems": 3
              },
              "vad": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "valence",
                  "arousal",
                  "dominance"
                ],
                "properties": {
                  "valence": {
                    "$ref": "#/$defs/signedUnit"
                  },
                  "arousal": {
                    "$ref": "#/$defs/signedUnit"
                  },
                  "dominance": {
                    "$ref": "#/$defs/signedUnit"
                  }
                }
              },
              "acac": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "arousal",
                  "control",
                  "approach",
                  "certainty"
                ],
                "properties": {
                  "arousal": {
                    "$ref": "#/$defs/triBand"
                  },
                  "control": {
                    "$ref": "#/$defs/triBand"
                  },
                  "approach": {
                    "type": "string",
                    "enum": [
                      "approach",
                      "balanced",
                      "avoid"
                    ]
                  },
                  "certainty": {
                    "$ref": "#/$defs/triBand"
                  }
                }
              }
            }
          },
          "confusable_pair": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "role"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "anchor",
                      "contrast"
                    ]
                  }
                }
              }
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "signedUnit": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "triBand": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "emotionLabel": {
      "type": "string",
      "enum": [
        "anger",
        "anticipation",
        "confusion",
        "disgust",
        "fear",
        "joy",
        "love",
        "neutral",
        "optimism",
        "pessimism",
        "sadness",
        "surprise",
        "trust"
      ]
    }
  }
}
