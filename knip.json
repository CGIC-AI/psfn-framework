{
  "$schema": "https://unpkg.com/knip@6.23.0/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/app/startup/index.ts",
        "src/app/agent/main.ts",
        "src/app/gateway/main.ts",
        "src/app/operator/main.ts",
        "src/app/e2e/contact-lifecycle-certification/agent-process.ts",
        "src/app/e2e/icp-certification/agent-process.ts",
        "src/app/maintenance/force-episodic-synthesis.ts",
        "src/app/maintenance/migrate-required-settings-blocks.ts",
        "src/app/maintenance/owner-upgrade-readiness-probe.ts",
        "src/app/maintenance/verify-shell-sandbox-runtime.ts",
        "src/core/emotion/calibration.ts",
        "src/persistence/sessions/turn-record-recovery-worker.ts",
        "src/persistence/sessions/turn-tombstone-authority-worker.ts",
        "scripts/**/*.{ts,mjs}"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.{ts,mjs}"
      ],
      "ignore": [
        "admin-ui/**",
        "companion-ui/**",
        "apps/satellite-hub/**",
        "tools/evals/**"
      ],
      "ignoreDependencies": [
        "@snazzah/davey",
        "sherpa-onnx-node"
      ],
      "ignoreBinaries": [
        "gh",
        "kubectl",
        "rg",
        "tail",
        "uv"
      ]
    }
  }
}
