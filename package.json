{
  "name": "psfn-framework",
  "version": "0.1.0",
  "description": "PSFN Substrate Framework — a purpose-built runtime for emergent artificial consciousness",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "postinstall": "npm install --prefix admin-ui",
    "dev": "./scripts/start-gateway-agent.sh",
    "start": "./scripts/start-gateway-agent.sh",
    "gateway": "tsx src/app/gateway/main.ts",
    "gateway:start": "node dist/gateway-main.js",
    "agent": "tsx src/app/agent/main.ts",
    "agent:start": "node dist/agent-main.js",
    "operator": "tsx src/app/operator/main.ts",
    "operator:start": "node dist/operator-main.js",
    "split": "./scripts/start-gateway-agent.sh",
    "split:debug": "./scripts/start-gateway-agent.sh --debug",
    "yolo": "./scripts/start-gateway-agent.sh --yolo",
    "yolo:debug": "./scripts/start-gateway-agent.sh --yolo --debug",
    "agent:docker": "docker compose -f docker/docker-compose.production.yml up --build",
    "agent:docker:continuous": "docker compose -f docker/docker-compose.yml up --build",
    "proxy:up": "docker compose --env-file .env -f proxy/docker-compose.yml up -d",
    "proxy:down": "docker compose --env-file .env -f proxy/docker-compose.yml down",
    "proxy:logs": "docker compose --env-file .env -f proxy/docker-compose.yml logs -f",
    "test": "vitest run",
    "test:privacy": "vitest run src/system/trust/privacy-regression.test.ts",
    "test:leak-audit": "vitest run src/core/session/context-leak-audit.test.ts",
    "test:watch": "vitest",
    "chat": "tsx src/app/cli/chat-cli.ts",
    "session:repair": "tsx src/app/maintenance/session-repair.ts",
    "session:repair:transcript-projection": "tsx src/app/maintenance/transcript-projection-repair.ts",
    "session:repair:attribution": "tsx src/app/maintenance/session-attribution-repair.ts",
    "session:repair:integrity": "tsx src/app/maintenance/session-integrity-repair.ts",
    "migrate:embeddings": "tsx src/app/maintenance/migrate-embeddings.ts",
    "prefetch:hf-models": "tsx scripts/prefetch-hf-models.ts",
    "eval:discover:logprobs": "tsx eval/discovery/probe-logprobs.ts",
    "eval:local:validate": "bash eval/local/scripts/validate-profiles.sh",
    "eval:local:vllm": "bash eval/local/scripts/launch-vllm.sh",
    "eval:local:llamacpp": "bash eval/local/scripts/launch-llamacpp.sh",
    "eval:local:probe:logprobs": "bash eval/local/scripts/probe-logprobs.sh",
    "eval:local:probe:hidden": "bash eval/local/scripts/probe-hidden-states.sh",
    "eval:repeng:validate": "python3 eval/repeng/validate_dataset.py --dataset eval/repeng/datasets/core-emotion-contrasts.json --dataset eval/repeng/datasets/acac-axis-contrasts.json --require-core-emotion-coverage --require-acac-coverage",
    "eval:repeng:smoke": "python3 eval/repeng/train_control_vectors.py --dataset eval/repeng/fixtures/smoke-contrasts.json --output-dir eval/repeng/artifacts/smoke --backend fixture --model-id fixture-hash-v1 --layers 0,1 --vector-dim 8 --seed 13 --run-id psfn-repeng-smoke --force && python3 eval/repeng/sanity_check.py --artifact-dir eval/repeng/artifacts/smoke",
    "eval:companion-shape:report": "tsx eval/companion-shape/report.ts",
    "migrate:persistence-layout": "tsx src/app/maintenance/migrate-persistence-layout.ts",
    "import-character": "tsx src/app/maintenance/import-character.ts",
    "e2e": "tsx src/app/e2e/e2e-test.ts",
    "e2e:voice": "tsx src/app/e2e/e2e-voice-roundtrip.ts",
    "smoke:chat": "node scripts/chat-cockpit-smoke.mjs",
    "smoke:discord:dm-voice": "node scripts/discord-dm-voice-smoke.mjs",
    "walkthrough": "tsx src/app/e2e/e2e-walkthrough.ts",
    "lint": "eslint .",
    "verify:startup-owner-files": "tsx scripts/verify-startup-owner-files.ts",
    "garden:dev": "npm --prefix admin-ui run dev",
    "garden:build": "npm --prefix admin-ui run build",
    "garden:preview": "npm --prefix admin-ui run preview",
    "verify:public-sanitize": "node scripts/public-sanitize-check.mjs",
    "verify:identity-literals": "node scripts/identity-literal-scan.mjs",
    "verify:dependency-cycles": "node scripts/check-dependency-cycles.mjs",
    "verify:repository-hygiene": "npm run verify:public-sanitize && npm run verify:identity-literals && npm run verify:dependency-cycles",
    "verify:settings-contract": "tsx scripts/verify-settings-contract.ts",
    "verify:backup-restore": "tsx scripts/verify-backup-restore.ts",
    "verify:agent-docker-isolation": "node scripts/verify-agent-docker-isolation.mjs",
    "eval:logprob:collect": "tsx eval/logprob-harness/collect.ts"
  },
  "dependencies": {
    "@character-foundry/character-foundry": "0.5.0",
    "@discordjs/voice": "0.19.0",
    "@huggingface/transformers": "3.8.1",
    "@mariozechner/pi-agent-core": "0.62.0",
    "@mariozechner/pi-ai": "0.62.0",
    "@mariozechner/pi-web-ui": "0.62.0",
    "@snazzah/davey": "0.1.9",
    "better-sqlite3": "11.10.0",
    "discord.js": "14.25.1",
    "dotenv": "16.6.1",
    "js-tiktoken": "1.0.21",
    "json-rpc-2.0": "1.7.1",
    "pg": "8.20.0",
    "pdfjs-dist": "5.4.394",
    "prism-media": "1.3.5",
    "sqlite-vec": "0.1.6",
    "uuid": "11.1.0",
    "winston": "3.19.0",
    "ws": "8.19.0"
  },
  "optionalDependencies": {
    "opusscript": "0.0.8"
  },
  "overrides": {
    "@discordjs/rest": {
      "undici": "6.23.0"
    },
    "discord.js": {
      "undici": "6.23.0"
    },
    "basic-ftp": "5.2.0",
    "fast-xml-parser": "5.4.2",
    "minimatch": "9.0.9",
    "tar": "7.5.10",
    "rollup": "4.59.0",
    "eslint": {
      "minimatch": "10.2.4"
    },
    "@eslint/config-array": {
      "minimatch": "10.2.4"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.11",
    "@types/uuid": "10.0.0",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "eslint": "10.0.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
