{
  "name": "psfn-framework",
  "version": "0.1.0",
  "description": "Purrsephone Substrate Framework — a purpose-built runtime for emergent artificial consciousness",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "gateway": "tsx src/gateway-main.ts",
    "gateway:start": "node dist/gateway-main.js",
    "agent": "tsx src/agent-main.ts",
    "agent:start": "node dist/agent-main.js",
    "split": "./scripts/start-gateway-agent.sh",
    "split:debug": "./scripts/start-gateway-agent.sh --debug",
    "yolo": "./scripts/start-gateway-agent.sh --yolo",
    "yolo:debug": "./scripts/start-gateway-agent.sh --yolo --debug",
    "agent:docker": "docker compose -f docker/docker-compose.yml up --build",
    "proxy:up": "docker compose -f proxy/docker-compose.yml up -d",
    "proxy:down": "docker compose -f proxy/docker-compose.yml down",
    "proxy:logs": "docker compose -f proxy/docker-compose.yml logs -f",
    "test": "vitest run",
    "test:privacy": "vitest run src/__tests__/privacy/privacy-regression.test.ts",
    "test:watch": "vitest",
    "chat": "tsx src/chat-cli.ts",
    "session:repair": "tsx src/session-repair.ts",
    "migrate:embeddings": "tsx src/migrate-embeddings.ts",
    "import-character": "tsx src/import-character.ts",
    "e2e": "tsx src/e2e-test.ts",
    "e2e:voice": "tsx src/e2e-voice-roundtrip.ts",
    "smoke:chat": "node scripts/chat-cockpit-smoke.mjs",
    "smoke:discord:dm-voice": "node scripts/discord-dm-voice-smoke.mjs",
    "walkthrough": "tsx src/e2e-walkthrough.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "garden:dev": "cd admin-ui && npm run dev",
    "garden:build": "cd admin-ui && npm run build",
    "garden:preview": "cd admin-ui && npm run preview"
  },
  "dependencies": {
    "@character-foundry/character-foundry": "^0.5.0",
    "@discordjs/voice": "^0.19.0",
    "@huggingface/transformers": "^3.8.1",
    "@mariozechner/pi-agent-core": "^0.52.12",
    "@mariozechner/pi-ai": "^0.52.12",
    "@mariozechner/pi-web-ui": "^0.52.12",
    "@snazzah/davey": "^0.1.9",
    "better-sqlite3": "^11.7.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "js-tiktoken": "^1.0.21",
    "json-rpc-2.0": "^1.7.1",
    "prism-media": "^1.3.5",
    "sqlite-vec": "^0.1.6",
    "uuid": "^11.0.0",
    "winston": "^3.19.0",
    "ws": "^8.19.0"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0",
    "opusscript": "^0.0.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
