# Copy to scripts/ops/private-ops.env (gitignored) or point PSFN_OPS_CONFIG at
# another repo-local ignored file. Never commit populated deployment values.

# Required by remote shipping, validation, and beads synchronization.
PSFN_HOST_ALIAS=

# Kubernetes/runtime wiring. Namespace defaults to the product namespace when
# omitted; every host-specific path must be supplied explicitly when used.
PSFN_NAMESPACE=psfn
PSFN_REMOTE_DIR=
PSFN_SOURCE_CHECKOUT=

# Generic storage/runbook inputs used by docs/operations.md.
PSFN_REPOSITORY_CHECKOUT=
PSFN_RUNTIME_DATA_PATH=
PSFN_POSTGRES_DATA_PATH=
PSFN_POSTGRES_HOST=127.0.0.1
PSFN_POSTGRES_PORT=5432
PSFN_APP_SERVICE=psfn.service
PSFN_HUB_SERVICE=psfn-satellite-hub.service
PSFN_UI_SERVICE=psfn-companion-ui.service
