[Unit]
Description=PSFN Substrate Runtime (user yolo mode)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/psfn-framework
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PSFN_DOTENV_FILE=.env
ExecStart=/bin/bash %h/psfn-framework/scripts/start-gateway-agent.sh --yolo
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=psfn

[Install]
WantedBy=default.target
