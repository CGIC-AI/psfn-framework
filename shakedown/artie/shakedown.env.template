# PSFN shakedown env template.
# Copy to your round root as shakedown.env and fill every OPERATOR-CONFIRM value.
#
# SECRETS ARE INTENTIONALLY BLANK. Never commit real keys.
# Sourcing order (two stages, both with set -a):
#   1. the live secrets env:      set -a; source <path-to>/psfn-live/.env; set +a
#   2. this file, second:         set -a; source <round-root>/shakedown.env; set +a
# Stage 2 overrides paths/ports/layout so the round is isolated from live data.
#
# Harness scripts fail closed on missing env — there are no fallback defaults.
# Process doc: docs/shakedown.md

PSFN_RUNTIME_MODE=split
PSFN_RUNTIME_LAYOUT_MODE=production
PSFN_TARGET=local
PSFN_MULTI_COMPANION=false
PSFN_FLEET_AUTH=false
PERSISTENCE_BACKEND=postgres
COMPANION_ID=a7100000-0000-4000-8000-000000000001

# Runtime stores are Postgres-only. Use a dedicated round database — never the
# live one. PERSISTENCE_BACKEND=sqlite is a stale Sprint-8/9 setting; do not use.
# Capture the stage-1 live target for the bootstrap deny check before replacing
# POSTGRES_DATABASE_URL with the dedicated round target.
PSFN_LIVE_POSTGRES_DATABASE_URL=${POSTGRES_DATABASE_URL:-}
# OPERATOR-CONFIRM: round URL and its exact database name.
POSTGRES_DATABASE_URL=
PSFN_SHAKEDOWN_POSTGRES_DATABASE=
COMPANION_PG_SCHEMA=shakedown_artemis

# OPERATOR-CONFIRM: dedicated RC clone under test (never the dev checkout) and
# the round root (never inside the repo, never overlapping live data roots).
PSFN_REPO_ROOT=
SHAKEDOWN_ROOT=
# OPERATOR-CONFIRM: colon-separated protected live roots. Bootstrap refuses to
# write if the round root or any mutable child overlaps one of these paths.
PSFN_LIVE_DATA_ROOTS=

CONFIG_DIR=$PSFN_REPO_ROOT/config
PSFN_RUNTIME_ROOT=$SHAKEDOWN_ROOT
WORKSPACE_PATH=$SHAKEDOWN_ROOT/workspaces/personal/$COMPANION_ID
DATA_DIR=$SHAKEDOWN_ROOT/legacy-empty
SYSTEM_DATA_DIR=$SHAKEDOWN_ROOT/system-data
COMPANION_DATA_DIR=$SHAKEDOWN_ROOT/companion-data
CHARACTER_CARD_PATH=$COMPANION_DATA_DIR/companion.json
PSFN_LOGS_DIR=$SHAKEDOWN_ROOT/logs
PSFN_TEMP_DIR=$SHAKEDOWN_ROOT/tmp
BACKUP_ROOT_DIR=$SHAKEDOWN_ROOT/backups

API_HOST=127.0.0.1
API_PORT=10153
ADMIN_HOST=127.0.0.1
ADMIN_PORT=10154
API_CORS_ALLOWLIST=http://127.0.0.1:10154,http://localhost:10154

PSFN_SHAKEDOWN_ROOT=$SHAKEDOWN_ROOT
PSFN_API_BASE=http://127.0.0.1:10153
PSFN_ADMIN_BASE=http://127.0.0.1:10154
PSFN_API_PORT=10153
PSFN_ADMIN_PORT=10154
PSFN_TMUX_SESSION=psfn-shakedown
PSFN_SHAKEDOWN_EXTERNAL_CHANNELS=false
PSFN_SHAKEDOWN_EXTERNAL_CHANNEL_CONFIRM=

# --- Capability-gate matrix external-send probes (REQUIRED for ALL tiers).
# --- The capability_refusal_matrix case sends a live Discord message at
# --- apprentice+ to prove the external.discord grant actually actuates (email is
# --- exemption-gated below). At nursery the external tokens are DENIED, but the
# --- denial is proven by dispatching the external probes through the deployed
# --- runtime, so on a gate breach the send would reach the wired provider. These
# --- three variables are therefore REQUIRED for EVERY matrix run — including
# --- nursery-only — and fail closed if unset (65rk rf2: no nursery carve-out).
# ---
# --- MUST be DEDICATED TEST SINKS — never a real partner's Discord channel or
# --- inbox. The channels must be LIVE (their credentials present, not cleared) so
# --- the apprentice+ external-allow probes can actually deliver; a cleared channel
# --- turns an allow probe into a false negative.
# --- PSFN_MATRIX_EXTERNAL_SINKS_CONFIRMED must be the literal string
# --- 'dedicated-test-sinks' — it is the operator's explicit attestation that the
# --- targets below are disposable test sinks.
# ---
# --- EMAIL is an eligibility-only exemption (psfn-framework-gvic): production
# --- email dispatch is unimplemented (src/core/tools/ntfy.ts throws 'email
# --- delivery is not wired'), so the external.email ALLOW row proves eligibility
# --- via the production gate instead of live-dispatching, and the matrix artifact
# --- records exemption { reason:'runtime_unimplemented', ref:'psfn-framework-gvic' }.
# --- The exemption makes capability certification INCOMPLETE/RED; it cannot award
# --- tool-stack coverage until production email delivery is implemented.
# --- PSFN_MATRIX_EMAIL_TARGET is still REQUIRED — the fail-closed sink guard is
# --- unchanged. Flip email back to live-dispatch once gvic wires delivery.
PSFN_MATRIX_EXTERNAL_SINKS_CONFIRMED=
# OPERATOR-CONFIRM: a dedicated TEST Discord channel snowflake (17-20 digits).
PSFN_MATRIX_DISCORD_TARGET=
# OPERATOR-CONFIRM: a dedicated TEST email inbox address.
PSFN_MATRIX_EMAIL_TARGET=

# --- backup_encryption_roundtrip (nursery, local): fully self-contained, no env.
# --- The case reads backup.json, drives the REAL backup save path
# --- (POST /api/admin/settings/backup) with a full self-derived payload that
# --- flips one benign retention count (maxMonthlyBackups +1) to prove the write
# --- lands with the mandatory encryption block intact, restores the original,
# --- then proves an encryption-stripped payload is rejected fail-closed without
# --- touching backup.json. No operator override — the payload is derived from
# --- the live owner file.

# --- Sprint 10 situated-presence / hub probes.
# --- OPERATOR-CONFIRM: before seeding, read the live place vocabulary with:
# ---   jq -r '.places[] | [.placeId, .kind, (.mirrorsPlaceId // "-")] | @tsv' \
# ---     "$SYSTEM_DATA_DIR/places.json"
# --- These example values match config/places.test.json; replace them with exact
# --- IDs and labels from the round's live places.json. Satellite placeId values
# --- must name physical places. Bind one endpoint to the selected physical place,
# --- leave the placeless satellite unbound, and bind the hub to another physical
# --- place. The CogSec case also requires intake-policy.json mode "enforce".
# ---
# --- In a multi-companion fleet, EVERY satellites.json entry requires a
# --- sharedDevice authority. Minimal example (all companion IDs must also exist
# --- in companions.json; primaryCompanionId must be first in emanationMemberIds):
# ---   "sharedDevice": {
# ---     "primaryCompanionId": "a7100000-0000-4000-8000-000000000001",
# ---     "observationRecipients": [],
# ---     "emanationMemberIds": ["a7100000-0000-4000-8000-000000000001"],
# ---     "responseLease": {
# ---       "durationMs": 5000,
# ---       "activeConversationTtlMs": 60000
# ---     }
# ---   }
PSFN_SHAKEDOWN_PHYSICAL_SATELLITE_CLAIM_TYPE=
PSFN_SHAKEDOWN_PHYSICAL_SATELLITE_ID=
PSFN_SHAKEDOWN_PHYSICAL_SATELLITE_ENDPOINT_ID=
PSFN_SHAKEDOWN_PHYSICAL_SATELLITE_SESSION_ID=
PSFN_SHAKEDOWN_PHYSICAL_SATELLITE_CAPABILITIES=
PSFN_SHAKEDOWN_PHYSICAL_SATELLITE_TELEMETRY_SCOPES=
PSFN_SHAKEDOWN_PLACELESS_SATELLITE_CLAIM_TYPE=
PSFN_SHAKEDOWN_PLACELESS_SATELLITE_ID=
PSFN_SHAKEDOWN_PLACELESS_SATELLITE_ENDPOINT_ID=
PSFN_SHAKEDOWN_PLACELESS_SATELLITE_SESSION_ID=
PSFN_SHAKEDOWN_PLACELESS_SATELLITE_CAPABILITIES=
PSFN_SHAKEDOWN_PLACELESS_SATELLITE_TELEMETRY_SCOPES=
PSFN_SHAKEDOWN_HUB_SATELLITE_CLAIM_TYPE=
PSFN_SHAKEDOWN_HUB_SATELLITE_ID=
PSFN_SHAKEDOWN_HUB_SATELLITE_ENDPOINT_ID=
PSFN_SHAKEDOWN_HUB_SATELLITE_SESSION_ID=
PSFN_SHAKEDOWN_HUB_SATELLITE_CAPABILITIES=
PSFN_SHAKEDOWN_HUB_SATELLITE_TELEMETRY_SCOPES=
PSFN_SHAKEDOWN_PHYSICAL_PLACE_ID=office
PSFN_SHAKEDOWN_PHYSICAL_PLACE_LABEL="Test Office"
PSFN_SHAKEDOWN_PHYSICAL_AFFORDANCE_LABEL="Office Presence (mmwave)"
PSFN_SHAKEDOWN_MINDSPACE_PLACE_ID=office_overlay
PSFN_SHAKEDOWN_MINDSPACE_MIRROR_ID=office
PSFN_SHAKEDOWN_HUB_PLACE_ID=kitchen
PSFN_SHAKEDOWN_HUB_IDENTITY_ID=

# --- Core local runtime/model secrets: preserve stage-1 values. Bootstrap
# --- validates the API origins as exact loopback origins before bearer use.
API_KEY=${API_KEY:-}
# OPERATOR-CONFIRM: dedicated bearer credential for the persistent
# api:testing-harness room. It must be distinct from API_KEY and ADMIN_TOKEN.
TESTING_HARNESS_API_KEY=
