{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psfn.local/eval/repeng/reader/result.schema.json",
  "title": "PSFN RepE Reader Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "createdAt",
    "controlVectorManifest",
    "reader",
    "scenarioCount",
    "scenarios",
    "projections",
    "logitLens",
    "layerSummaries",
    "honestLayer"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "artifactType": {
      "type": "string",
      "const": "psfn.repeng_reader_result"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "controlVectorManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "artifactId",
        "datasetId",
        "trainingBackend",
        "modelId",
        "layers",
        "axisIds"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "trainingBackend": {
          "type": "string",
          "enum": [
            "fixture",
            "transformers"
          ]
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "axisIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "reader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "projectionPool",
        "targetLayers",
        "logitLensTopK"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "fixture",
            "transformers"
          ]
        },
        "projectionPool": {
          "type": "string",
          "enum": [
            "mean",
            "last"
          ]
        },
        "targetLayers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "logitLensTopK": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scenarioCount": {
      "type": "integer",
      "minimum": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/projection"
      }
    },
    "logitLens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/logitLensEntry"
      }
    },
    "layerSummaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layerSummary"
      }
    },
    "honestLayer": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/honestLayer"
        }
      ]
    }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "expectedScores",
        "source",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "expectedScores": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "$ref": "#/$defs/jsonValue"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "axisId",
        "layer",
        "projection",
        "hiddenNorm",
        "vectorNorm",
        "expectedScore",
        "alignment"
      ],
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "axisId": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "projection": {
          "type": "number"
        },
        "hiddenNorm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "vectorNorm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "expectedScore": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          ]
        },
        "alignment": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        }
      }
    },
    "logitLensEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "layer",
        "topTokens"
      ],
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "topTokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/topToken"
          }
        }
      }
    },
    "topToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "tokenId",
        "token",
        "score"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "tokenId": {
          "type": "integer",
          "minimum": 0
        },
        "token": {
          "type": "string"
        },
        "score": {
          "type": "number"
        }
      }
    },
    "layerSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "evidenceCount",
        "meanExpectedAlignment",
        "signAccuracy",
        "pearsonCorrelation"
      ],
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "meanExpectedAlignment": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "signAccuracy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ]
        },
        "pearsonCorrelation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          ]
        }
      }
    },
    "honestLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "selectionMetric",
        "evidenceCount",
        "signAccuracy",
        "meanExpectedAlignment",
        "pearsonCorrelation"
      ],
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "selectionMetric": {
          "type": "string",
          "const": "sign_accuracy_then_mean_expected_alignment"
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 1
        },
        "signAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "meanExpectedAlignment": {
          "type": "number"
        },
        "pearsonCorrelation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          ]
        }
      }
    }
  }
}
